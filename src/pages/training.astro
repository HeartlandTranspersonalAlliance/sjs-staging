---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site, trainingTopics } from "../data/site";
import { withBase } from "../utils/paths";

const trainingFlow = [
  {
    icon: "clipboard",
    title: "Onboarding",
    text: "Mission, role boundaries, confidentiality limits, volunteer expectations, and how SJS works with event teams."
  },
  {
    icon: "message",
    title: "Practice",
    text: "Role plays for consent-first communication, non-touch grounding, de-escalation, documentation, and warm handoff."
  },
  {
    icon: "map",
    title: "Deployment",
    text: "Event briefing, shift expectations, supplies, escalation pathways, and post-event debrief."
  }
];
---

<BaseLayout title="Training" description="Narcan/opioid overdose response, CPR, and peer support training available by request for groups, organizations, and communities.">
  <PageHero
    eyebrow="Training"
    title="Training for clear, reliable support."
    text="Training is available by request for groups, organizations, and communities."
    image="/assets/blog/dale-patrick.jpg"
    imageAlt="SJS outreach moment with harm-reduction education"
    imagePosition="center 35%"
  />

  <section class="section-tight">
    <div class="site-container split-grid">
      <div>
        <h2>Training options</h2>
        <a class="button button-primary" href={`mailto:${site.email}?subject=SJS%20training%20inquiry`}>Request Training</a>
      </div>
      <ul class="content-list training-options">
        <li>Narcan / opioid overdose response</li>
        <li>CPR</li>
        <li>Peer support</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="site-container section-heading"><h2>Volunteer preparation</h2></div>
    <div class="site-container card-grid">
      {
        trainingFlow.map((step) => (
          <article class="surface service-card">
            <span class="card-icon" aria-hidden="true"><Icon name={step.icon} /></span>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-tight training-band">
    <div class="site-container">
      <p class="eyebrow">Curriculum areas</p>
      <h2>Volunteer curriculum</h2>
      <ul class="topic-grid" role="list">
        {trainingTopics.map((topic) => <li>{topic}</li>)}
      </ul>
      <div class="button-row">
        <a class="button button-primary" href={site.forms.volunteer}>Apply to Volunteer</a>
        <a class="button button-ghost" href={withBase("/volunteer/")}>Volunteer Details</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-options li { font-weight: 700; }
  .service-card h2 {
    font-size: 1.22rem;
    margin: 0 0 10px;
  }

  .service-card p {
    color: var(--muted);
  }

  .training-band {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .training-band h2 {
    margin: 8px 0 22px;
  }

  .topic-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .topic-grid li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-weight: 800;
    padding: 14px;
  }

  @media (max-width: 760px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
