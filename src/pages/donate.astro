---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { supportOptions } from "../data/site";
---

<BaseLayout title="Donate" description="Support SJS through donations, recurring gifts, supplies, sponsorship, and event partnerships.">
  <PageHero
    eyebrow="Donate / support"
    title="Help stock, train, and show up prepared."
    text="SJS depends on community support for sanctuary supplies, harm-reduction materials, volunteer training, outreach, and event readiness."
    art="support"
  />

  <section class="section">
    <div class="container">
      <div class="notice">
        Donations are processed through Heartland Transpersonal Alliance, the 501(c)(3) nonprofit home for Safe Journey Sanctum.
      </div>
      <div class="card-grid support-grid">
        {
          supportOptions.map((option) => (
            <article class="surface service-card">
              <span class="card-icon" aria-hidden="true"><Icon name={option.icon} /></span>
              <h2>{option.title}</h2>
              <p>{option.text}</p>
              <a href={option.href}>{option.label}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">What gifts fund</p>
        <h2>Supplies, training, and outreach.</h2>
      </div>
      <ul class="funding-list">
        <li>Soft flooring, blankets, cushions, lighting, and signage</li>
        <li>Overdose education materials and response readiness</li>
        <li>Volunteer training, meals, documentation, and debriefs</li>
        <li>Storage, transportation, printing, and community outreach</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .support-grid {
    margin-top: 26px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .service-card h2 {
    font-size: 1.22rem;
    margin: 0 0 10px;
  }

  .service-card p {
    color: var(--muted);
    margin-bottom: 16px;
  }

  .funding-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .funding-list li + li {
    margin-top: 10px;
  }

  @media (max-width: 760px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
