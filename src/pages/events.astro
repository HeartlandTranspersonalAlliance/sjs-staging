---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import IconBadge from "../components/ui/IconBadge.astro";
import { featuredEvent, site } from "../data/site";
import { withBase } from "../utils/paths";

const eventTypes = [
  {
    icon: "message",
    title: "Integration circles",
    status: "Inquiries welcome",
    text: "Small community gatherings for reflection, grounding skills, and peer connection after meaningful or difficult experiences.",
    href: "/contact/",
    label: "Ask about circles"
  },
  {
    icon: "clipboard",
    title: "Harm-reduction trainings",
    status: "Available by request",
    text: "Narcan/opioid overdose response, CPR, and peer support training for groups, organizations, and communities.",
    href: "/training/",
    label: "View training"
  },
  {
    icon: "home",
    title: "Festival outreach",
    status: "Active service / event coordination required",
    text: "Sanctuary support, education, fentanyl reagent testing, and on-site coordination with organizers, medical teams, security, and production staff.",
    href: "/organizers/",
    label: "Plan outreach"
  }
];
---

<BaseLayout title="Events" description="SJS event formats, recent field work, trainings, and ways to get involved.">
  <PageHero
    eyebrow="Events"
    title="Sanctuary support, trainings, and community spaces."
    text="SJS supports festivals, concerts, and community gatherings while building volunteer education and integration opportunities between event deployments."
    art="events"
  />

  <section class="section">
    <div class="site-container">
      <div class="notice empty-events">
        <IconBadge name="calendar" />
        <div>
          <strong>No upcoming dates are confirmed yet.</strong>
          <p>
            Confirmed trainings, sanctuary deployments, and community circles will be posted as dates are finalized. Email SJS to be notified when new events open.
          </p>
          <Button variant="ghost" size="sm" href={site.forms.contact}>Email for updates</Button>
        </div>
      </div>
      <article class="surface field-event-card" id="recent-work">
        <div>
          <p class="post-meta">Recent field work / {featuredEvent.dateLabel}</p>
          <h2>{featuredEvent.title}</h2>
          <p>{featuredEvent.location} · {featuredEvent.summary}</p>
        </div>
        <a class="button button-ghost" href={withBase(featuredEvent.href)}>Read the field recap</a>
      </article>
      <div class="card-grid event-grid">
        {
          eventTypes.map((event) => (
            <Card icon={event.icon} class="service-card">
              <h2>{event.title}</h2>
              <p class="service-status">{event.status}</p>
              <p>{event.text}</p>
              <a class="button button-ghost card-action" href={withBase(event.href)} aria-label={`${event.label}: ${event.title}`}>{event.label}</a>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight band">
    <div class="site-container split-grid">
      <div>
        <p class="eyebrow">Bring SJS to an event</p>
        <h2>Want SJS at an event?</h2>
      </div>
      <div class="prose">
        <p>
          Event organizers can request sanctuary support, harm-reduction education, supplies, and coordination planning. Volunteers can apply now so they are ready when new events are confirmed.
        </p>
        <div class="button-row">
          <Button variant="primary" href="/volunteer/">Volunteer for Events</Button>
          <Button variant="ghost" href="/organizers/">Bring SJS to an Event</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .event-grid {
    margin-top: 24px;
  }

  .field-event-card {
    align-items: center;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    margin-top: 24px;
    padding: 24px;
  }

  .field-event-card h2 {
    font-size: 1.35rem;
    margin: 4px 0 8px;
  }

  .field-event-card p:last-child {
    color: var(--muted);
    max-width: 62ch;
  }

  .empty-events {
    align-items: flex-start;
    display: flex;
    gap: 14px;
  }

  .empty-events :global(.card-icon) {
    margin-bottom: 0;
  }

  .empty-events strong {
    display: block;
    font-weight: 900;
    margin-bottom: 0.2rem;
  }

  .empty-events p {
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .event-grid h2 {
    font-size: 1.22rem;
    margin: 0 0 10px;
  }

  .event-grid p {
    color: var(--muted);
  }

  .event-grid .service-status {
    color: var(--moss);
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0.02em;
    margin-bottom: 8px;
  }

  .band .button-ghost {
    background: var(--button-ghost-bg);
    color: var(--band-text);
  }

  @media (max-width: 560px) {
    .empty-events {
      display: grid;
    }

    .field-event-card {
      align-items: flex-start;
      flex-direction: column;
    }

    .field-event-card .button {
      width: 100%;
    }
  }
</style>
