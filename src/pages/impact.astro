---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { featuredEvent } from "../data/site";
import { withBase } from "../utils/paths";

---

<BaseLayout title="Impact" description="Field recaps from SJS event deployments.">
  <PageHero
    eyebrow="Impact"
    title="SJS in the field."
    text="Field notes from sanctuary support and harm-reduction outreach at Midwest events."
    art="impact"
  />

  <section class="section-tight band">
    <div class="site-container split-grid">
      <div>
        <p class="eyebrow">Field recap</p>
        <h2>{featuredEvent.title}</h2>
      </div>
      <div class="prose">
        <p>
          SJS provided 24/7 support in {featuredEvent.location} from Thursday, June 4 through the morning of Sunday, June 7, 2026. Read the recap for the deployment details and field notes.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={withBase(featuredEvent.href)}>Read Cosmic Kinection Recap</a>
          <a class="button button-ghost" href={withBase("/news/getter/")}>Earlier Getter Recap</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
