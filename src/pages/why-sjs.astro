---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import { eventServices, site } from "../data/site";
---
<BaseLayout title="Why SJS" description="How SJS provides sanctuary peer support and harm reduction at events.">
  <PageHero eyebrow="For organizers" title="What SJS brings to your event" text="We offer a sanctuary space, peer support and harm reduction services. We coordinate with your event’s existing safety team." art="organizers" />
  <section class="section" id="capabilities">
    <div class="site-container split-grid">
      <div>
        <h2>Services available at events</h2>
        <p>Which services we can offer depends on event approval, supplies and local requirements.</p>
      </div>
      <ul class="content-list">{eventServices.map(service => <li>{service}</li>)}</ul>
    </div>
  </section>
  <section class="section-tight band">
    <div class="site-container split-grid">
      <h2>Plan support for your event</h2>
      <div class="button-row">
        <Button href="/organizers/" variant="amber">Planning for organizers</Button>
        <Button href={site.forms.partnership} variant="ghost">Email event details</Button>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  p { color: var(--muted); max-width: 50ch; }
</style>
