---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import { eventServices, site } from "../data/site";
---
<BaseLayout title="Why SJS" description="Sanctuary peer support, practical harm reduction, and event safety coordination in one integrated model.">
  <PageHero eyebrow="Why SJS / for organizers" title="An integrated event care model." text="SJS combines sanctuary peer support, harm-reduction education, practical supplies, fentanyl reagent testing, and event safety coordination." art="organizers" />
  <section class="section" id="capabilities">
    <div class="site-container split-grid">
      <div>
        <h2>Built for the live-event care environment.</h2>
        <p>SJS service details depend on event approval, inventory, and local requirements.</p>
      </div>
      <ul class="capabilities">{eventServices.map(service => <li>{service}</li>)}</ul>
    </div>
  </section>
  <section class="section-tight band">
    <div class="site-container split-grid">
      <h2>Bring SJS into your event care plan.</h2>
      <div class="button-row">
        <Button href="/organizers/" variant="amber">For Organizers</Button>
        <Button href={site.forms.partnership} variant="ghost">Email Event Details</Button>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  p { color: var(--muted); max-width: 50ch; }
  .capabilities { list-style: none; margin: 0; padding: 0; }
  .capabilities li { border-top: 1px solid var(--line); padding: 16px 0; }
</style>
