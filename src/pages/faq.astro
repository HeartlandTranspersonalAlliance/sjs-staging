---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageContents from "../components/PageContents.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../data/site";

const faqGroups = [
  {
    title: "Getting Support",
    faqs: [
      {
        question: "What is Safe Journey Sanctum?",
        answer:
          "At festivals, concerts and community events, Safe Journey Sanctum offers peer support to people who feel overwhelmed, distressed or disoriented. You choose whether to accept support."
      },
      {
        question: "What is peer support?",
        answer:
          "A peer support volunteer can sit with you and listen without judgment. They can help reduce stimulation, find trusted friends or walk with you to another source of support."
      },
      {
        question: "Do I have to be on psychedelics or other substances to ask for support?",
        answer:
          "No. You can ask for a quieter place, someone to sit with you, or help getting oriented. Volunteers won’t assume you’ve taken anything."
      },
      {
        question: "What might support look like at an event?",
        answer:
          "Support may include active listening, reassurance, grounding, a lower-stimulation space when available, harm-reduction education, hydration reminders, or a warm handoff to medical, security, friends, or other event support."
      }
    ]
  },
  {
    title: "Scope and Safety",
    faqs: [
      {
        question: "What can SJS help with?",
        answer:
          "SJS can help with nonordinary or difficult experiences, anxiety, panic, emotional distress, overstimulation, grounding, harm-reduction education, and finding the right next support step. Volunteers focus on calm presence, choice, and practical safety."
      },
      {
        question: "What can SJS not provide?",
        answer:
          "SJS does not provide medical diagnosis or treatment, psychotherapy, medical clearance, security enforcement, or law-enforcement functions."
      },
      {
        question: "Does SJS offer fentanyl reagent testing?",
        answer:
          "Yes. Fentanyl reagent testing is an additional SJS service. Availability, timing, and process depend on event approval, local requirements, staffing, and supplies. Testing does not make substance use safe or replace medical care."
      },
      {
        question: "When will SJS involve medical support?",
        answer:
          "SJS involves medical support immediately for concerns such as unconsciousness, abnormal breathing, suspected overdose, chest pain, seizure, serious injury, heat illness, severe vomiting, pregnancy-related concerns, suicidality, or any situation where medical risk is unclear."
      },
      {
        question: "What happens if someone may be overdosing?",
        answer:
          "If opioid overdose is suspected, SJS calls medical or emergency response immediately and follows the event plan. Naloxone may be used by trained and authorized people when available, and the person should receive medical evaluation afterward."
      },
      {
        question: "Does SJS work with event medical, security, and operations teams?",
        answer:
          "Yes. SJS coordinates with event medics, security, rangers, venue staff and operations teams so guests can reach the right people quickly."
      }
    ]
  },
  {
    title: "Consent, Privacy, and Boundaries",
    faqs: [
      {
        question: "Will volunteers touch me?",
        answer:
          "The default is no touch. If touch might help, volunteers should ask clearly first, offer no-touch options, and keep any consented touch minimal, nonsexual, visible, and easy to stop."
      },
      {
        question: "Can I say no to support?",
        answer:
          "Yes. SJS is consent-centered and aims to preserve autonomy whenever safe. Volunteers may still involve medical or safety support if there is immediate risk to you or others."
      },
      {
        question: "Is what I share confidential?",
        answer:
          "SJS protects privacy where possible and avoids gossip, unnecessary details, photos, or recordings of people receiving support. Confidentiality may be limited by immediate safety concerns, legal obligations, mandatory reporting duties, event medical or security needs, or serious community risk."
      },
      {
        question: "Can a friend stay with me?",
        answer:
          "Usually, if you want them there and they are calm, supportive, and safe. SJS may involve a shift lead, medical, or security if a friend appears intoxicated, coercive, unsafe, or connected to the distress."
      }
    ]
  },
  {
    title: "Integration and Aftercare",
    faqs: [
      {
        question: "What is integration after a nonordinary experience?",
        answer:
          "Integration is the process of making sense of a psychedelic, emotional, spiritual, or other nonordinary experience and bringing useful lessons into everyday life in a grounded way."
      },
      {
        question: "What can integration look like?",
        answer:
          "Integration can include rest, journaling, art, time in nature, gentle movement, talking with a trusted person, joining an integration circle, or working with a therapist or integration-informed clinician."
      },
      {
        question: "What is the goal of integration?",
        answer:
          "Take time to ask what feels helpful, safe and sustainable in everyday life. You don’t need to force a meaning or make major decisions right away. Question an insight before treating it as true."
      },
      {
        question: "Where can I find ongoing integration support?",
        answer:
          "Kansas City readers can look for the Kansas City Integration Circle. St. Louis readers can contact the Psychedelic Society of St. Louis. The Global Psychedelic Society also maintains a worldwide directory of psychedelic societies and community resources."
      }
    ]
  },
  {
    title: "Event Organizers",
    faqs: [
      {
        question: "Can SJS support my event?",
        answer:
          "SJS may be able to support events that want a calm sanctuary space, peer support, harm-reduction education, practical supplies when stocked, overdose awareness, and clear coordination with existing safety teams."
      },
      {
        question: "What does SJS need from an event?",
        answer:
          "Useful planning details include the event date, location, expected attendance, event type, hours of operation, existing medical and security contacts, venue layout, known risks, and the support being requested."
      },
      {
        question: "What kind of space works best?",
        answer:
          "Choose a quieter place that guests can find easily. It should provide privacy without leaving guests or volunteers isolated. Nearby water and bathrooms help; medical responders must be able to reach it."
      },
      {
        question: "How does SJS reduce role confusion at events?",
        answer:
          "Before an event, a written plan helps everyone know whom to call, which radio or phone channels to use, when to ask for help, and which team takes over."
      }
    ]
  },
  {
    title: "Volunteering and Training",
    faqs: [
      {
        question: "Can anyone volunteer with SJS?",
        answer:
          "If you share our approach to peer support, you’re welcome to apply. Volunteers complete onboarding, ask for consent, protect confidentiality and communicate calmly. They respect boundaries and stay within their role."
      },
      {
        question: "Do volunteers need to be therapists or medical professionals?",
        answer:
          "No. Those backgrounds can help. SJS provides peer support, which does not include therapy or medical care. Volunteers need to stay calm, listen without judgment, be willing to learn, follow procedures and know when to call for help."
      },
      {
        question: "What does SJS training emphasize?",
        answer:
          "Training emphasizes role and scope, consent and touch boundaries, non-touch grounding, medical red flags, overdose response, warm handoffs, survivor-sensitive response, confidentiality limits, conflict-of-interest awareness, and incident documentation."
      },
      {
        question: "What is expected of volunteers during a shift?",
        answer:
          "Volunteers are expected to be sober and fit for duty, know the escalation pathways, respect the code of conduct, know who the shift lead is, and ask for backup when a situation may exceed their role."
      }
    ]
  }
];

const groupId = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<BaseLayout title="FAQ" description="Frequently asked questions about SJS peer support, safety boundaries, integration, volunteering, and event partnerships.">
  <PageHero
    title="Frequently asked questions"
    text="Find out what to expect if you ask for support, invite SJS to an event, or apply to volunteer."
    art="resources"
  />

  <PageContents
    items={[
      { label: "Start here", href: "#faq-note-title" },
      { label: "Getting support", href: "#getting-support" },
      { label: "Scope and safety", href: "#scope-and-safety" },
      { label: "Privacy and boundaries", href: "#consent-privacy-and-boundaries" },
      { label: "Integration", href: "#integration-and-aftercare" },
      { label: "Organizers", href: "#event-organizers" },
      { label: "Volunteering", href: "#volunteering-and-training" }
    ]}
  />

  <section class="section faq-intro" aria-labelledby="faq-note-title">
    <div class="site-container split-grid">
      <div>
        <h2 id="faq-note-title">Peer support and emergency care</h2>
      </div>
      <p>
        If there is immediate danger or a medical emergency, contact on-site medical/security personnel or call 911 first. SJS can help with grounding and warm handoffs, but emergency care comes first when safety is at risk.
      </p>
    </div>
  </section>

  <section class="section faq-section">
    <div class="site-container faq-shell">
      {
        faqGroups.map((group) => (
          <section class="faq-group" aria-labelledby={groupId(group.title)}>
            <h2 id={groupId(group.title)}>{group.title}</h2>
            <div class="faq-list">
              {
                group.faqs.map((item) => (
                  <details>
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section-tight faq-cta">
    <div class="site-container split-grid">
      <div>
        <h2>Request event support or volunteer</h2>
      </div>
      <div class="cta-actions">
        <Button href={site.forms.partnership} variant="amber">Email event details</Button>
        <Button href={site.forms.volunteer} variant="ghost">Apply to volunteer</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-intro,
  .faq-cta {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .faq-intro h2,
  .faq-cta h2 {
    margin: 0;
  }

  .faq-intro p,
  .faq-cta p {
    color: var(--muted);
    margin: 0;
  }

  .faq-section {
    padding-top: 72px;
  }

  .faq-shell {
    display: grid;
    gap: 48px;
    max-width: 960px;
  }

  .faq-group h2 {
    font-size: var(--type-section-title);
    margin: 0 0 18px;
  }

  .faq-list {
    display: grid;
    gap: 12px;
  }

  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0;
  }

  summary {
    cursor: pointer;
    font-family: "Source Sans 3", Aptos, "Segoe UI", sans-serif;
    font-size: 1.08rem;
    font-weight: 850;
    list-style: none;
    padding: 20px 24px;
  }

  summary:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    color: var(--amber);
    content: "+";
    float: right;
    font-family: "Source Sans 3", Aptos, sans-serif;
    font-weight: 900;
  }

  details[open] summary::after {
    content: "-";
  }

  details p {
    border-top: 1px solid var(--line);
    color: var(--muted);
    padding: 18px 24px 22px;
  }

  .cta-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }

  @media (max-width: 760px) {
    .faq-section {
      padding-top: 56px;
    }

    .faq-shell {
      gap: 36px;
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }
</style>
