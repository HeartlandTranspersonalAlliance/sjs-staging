---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const faqs = [
  {
    question: "What is Safe Journey Sanctum?",
    answer:
      "Safe Journey Sanctum provides trauma-informed, consent-based peer support to people experiencing intense emotional or psychedelic episodes at music festivals, concerts, and community events."
  },
  {
    question: "What services does SJS offer at events?",
    answer:
      "SJS offers peer support, sanctuary space, educational resources, Narcan availability, and coordination with medical, security, and production teams."
  },
  {
    question: "Are there training or education opportunities?",
    answer:
      "Yes. SJS hosts volunteer onboarding and community education that can include Narcan, CPR, de-escalation, consent-first communication, and event-specific peer-support protocols."
  },
  {
    question: "How does SJS manage liability at events?",
    answer:
      "SJS works alongside on-site medical and security teams, uses trained volunteers, follows operational boundaries, and escalates promptly when a guest needs professional support."
  },
  {
    question: "Can anyone volunteer with SJS?",
    answer:
      "People who align with the mission are welcome to apply. Volunteers complete training and are expected to practice consent, confidentiality, grounded communication, and clear boundaries."
  },
  {
    question: "How can my event partner with SJS?",
    answer:
      "Event organizers can use the contact or partnership form with the event date, location, expected attendance, existing medical/security plan, and the kind of support requested."
  },
  {
    question: "What is a nonordinary state of consciousness?",
    answer:
      "A nonordinary state can include intense emotional, spiritual, dissociative, psychedelic, grief, panic, or overwhelm experiences. SJS focuses on support and safety rather than interpretation."
  },
  {
    question: "What does harm reduction mean here?",
    answer:
      "Harm reduction means offering education, practical tools, and compassionate support to reduce avoidable harm without judgment or encouragement of substance use."
  },
  {
    question: "How can I prepare for a festival or event experience?",
    answer:
      "Plan transport, hydration, food, rest, buddy check-ins, and where to find medical or harm-reduction services. Avoid mixing substances, start low if you choose to use, and seek help early if something feels wrong."
  }
];
---

<BaseLayout title="FAQ" description="Frequently asked questions about SJS services, training, volunteering, and event partnerships.">
  <PageHero
    eyebrow="FAQ"
    title="Questions organizers, volunteers, and guests ask first."
    text="Clear expectations make the sanctuary safer for everyone. These answers summarize what SJS does, what it does not do, and how to connect."
    art="resources"
  />

  <section class="section">
    <div class="container faq-list">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 900px;
  }

  details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0;
  }

  summary {
    cursor: pointer;
    font-family: "Source Sans 3", Aptos, "Segoe UI", sans-serif;
    font-size: 1.08rem;
    font-weight: 850;
    list-style: none;
    padding: 20px 24px;
  }

  summary:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    color: var(--amber);
    content: "+";
    float: right;
    font-family: "Source Sans 3", Aptos, sans-serif;
    font-weight: 900;
  }

  details[open] summary::after {
    content: "-";
  }

  details p {
    border-top: 1px solid var(--line);
    color: var(--muted);
    padding: 18px 24px 22px;
  }
</style>
