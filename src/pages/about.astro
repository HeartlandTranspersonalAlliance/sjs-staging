---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="About"
  description="How Safe Journey Sanctum provides peer support at Midwest events and works with Heartland Transpersonal Alliance."
  image="/assets/events/ck2026/inside-sanctuary-day.jpeg"
>
  <PageHero
    title="About Safe Journey Sanctum"
    text="We provide consent-based peer support and harm reduction at festivals, concerts and community events. Our volunteers are trained to support people in nonordinary states or who feel overwhelmed."
    art="sanctuary"
  />

  <section class="section">
    <div class="site-container split-grid about-mission-grid">
      <div class="prose">
        <h2>Mission</h2>
        <p>
          We started SJS so people going through a difficult experience at an event would have somewhere quiet to go and someone to listen. Volunteers start by asking what support the guest wants.
        </p>
        <p>
          We draw on peer support and harm reduction practices and adapt the space and staffing to each event.
        </p>
      </div>
      <Card icon="home" class="service-card">
        <h3>Inside the sanctuary</h3>
        <p>
          Inside you’ll find soft lighting, seating, blankets and art supplies. Our volunteers can listen or share harm reduction information. We coordinate with the event’s medical, security and production teams when a guest needs more support.
        </p>
      </Card>
    </div>
  </section>

  <section class="section-tight band">
    <div class="site-container split-grid">
      <div>
        <h2 class="nonprofit-heading">Heartland Transpersonal Alliance</h2>
      </div>
      <div class="prose">
        <p>
          {site.nonprofit}
        </p>
        <p>
          Through HTA, we accept donations, develop training and work with event organizers.
        </p>
        <Button variant="ghost" href={site.parentOrg.url} target="_blank">Visit Heartland Transpersonal Alliance</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container two-grid">
      <Card icon="compass" class="resource-card">
        <h3>What we’re working toward</h3>
        <p>
          We want peer support and harm reduction supplies to be easy to find at Midwest events.
        </p>
      </Card>
      <Card icon="sparkles" class="resource-card">
        <h3>How we work with events</h3>
        <p>
          We train volunteers, plan with organizers and talk through what worked after each event.
        </p>
      </Card>
    </div>
  </section>

  <section class="section-tight about-cta">
    <div class="site-container split-grid">
      <div>
        <h2>Support the sanctuary</h2>
      </div>
      <div class="prose">
        <p>
          Volunteer at an event or help us cover the cost of supplies.
        </p>
        <div class="button-row">
          <Button variant="primary" href={site.forms.volunteer}>Apply to volunteer</Button>
          <Button variant="amber" href="/donate/">Donate</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-mission-grid {
    align-items: stretch;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .nonprofit-heading {
    max-width: 12em;
    overflow-wrap: normal;
    word-break: normal;
  }

  .about-cta {
    background: var(--linen);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .about-mission-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
