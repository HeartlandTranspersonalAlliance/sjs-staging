---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="About"
  description="Safe Journey Sanctum's mission, vision, and nonprofit relationship."
  image="/assets/sjs_home_background.png"
>
  <PageHero
    eyebrow="About SJS"
    title="Peer-led sanctuary care with practical harm reduction."
    text="Safe Journey Sanctum provides trauma-informed, consent-based support to people navigating nonordinary, intense, or overwhelming states at festivals, concerts, and community events."
    image="/assets/sjs_home_background.png"
    imageAlt="A calm outdoor sanctuary space at dusk with soft lantern light"
    imagePosition="center 62%"
  />

  <section class="section">
    <div class="container split-grid about-mission-grid">
      <div class="prose">
        <h2>Mission</h2>
        <p>
          SJS was founded to create supportive spaces where challenging experiences can become safer, more grounded, and less isolating. Volunteers offer presence rather than advice, and every interaction begins with consent.
        </p>
        <p>
          Our work draws from established peer-support and harm-reduction models while adapting the approach to Midwest event culture and local community needs.
        </p>
      </div>
      <Card icon="home" class="service-card">
        <h3>What sanctuary looks like</h3>
        <p>
          Comfortable lighting, soft seating, blankets, grounding materials, art supplies, harm-reduction education, and volunteers who can listen without judgment. SJS also coordinates with medical, security, and production teams so guests can receive the right level of care.
        </p>
      </Card>
    </div>
  </section>

  <section class="section-tight band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Nonprofit relationship</p>
        <h2 class="nonprofit-heading">Organized through Heartland Transpersonal Alliance.</h2>
      </div>
      <div class="prose">
        <p>
          {site.nonprofit}
        </p>
        <p>
          This relationship helps SJS receive support, develop training, and collaborate with organizers while keeping the work accountable to a nonprofit mission.
        </p>
        <Button variant="ghost" href={site.parentOrg.url} target="_blank">Visit HTA</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-grid">
      <Card icon="compass" class="resource-card">
        <h3>Vision</h3>
        <p>
          A Midwest event culture where peer support, harm-reduction education, and practical supplies are easy to find, emotionally grounded, and trusted by guests, organizers, artists, and care teams.
        </p>
      </Card>
      <Card icon="sparkles" class="resource-card">
        <h3>How we grow</h3>
        <p>
          SJS offers volunteer training, event partnerships, educational resources, and post-event reflection so each deployment strengthens the next one.
        </p>
      </Card>
    </div>
  </section>

  <section class="section-tight about-cta">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Take the next step</p>
        <h2>Help staff and supply sanctuary spaces.</h2>
      </div>
      <div class="prose">
        <p>
          SJS grows through trained volunteers, event partnerships, and practical material support for calm, low-stimulation care spaces.
        </p>
        <div class="button-row">
          <Button variant="primary" href={site.forms.volunteer}>Volunteer</Button>
          <Button variant="amber" href="/donate/">Donate</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-mission-grid {
    align-items: stretch;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .nonprofit-heading {
    max-width: 12em;
    overflow-wrap: normal;
    word-break: normal;
  }

  .about-cta {
    background: var(--linen);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .about-mission-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
