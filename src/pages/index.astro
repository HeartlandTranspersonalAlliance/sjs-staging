---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EmergencyNotice from "../components/EmergencyNotice.astro";
import FieldPhoto from "../components/FieldPhoto.astro";
import Button from "../components/ui/Button.astro";
import { carePrinciples, site } from "../data/site";
import { withBase } from "../utils/paths";
import { formatDate } from "../utils/dates";
const posts = (await getCollection("news"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout title={site.name} image="/assets/events/ck2026/outside-sanctuary-welcome-night.jpeg">
  <section class="home-hero">
    <div class="site-container hero-grid">
      <div class="centered-copy">
        <p class="eyebrow">Midwest peer support and harm reduction</p>
        <h1>Peer support and harm reduction for nonordinary states.</h1>
        <p class="lede">Safe Journey Sanctum helps Midwest events support people with trained volunteers, low-stimulation spaces, practical harm-reduction education, and clear handoffs to medical or security teams when needed.</p>
        <div class="button-row" role="group" aria-label="Primary actions">
          <Button variant="amber" href="/organizers/">For Organizers</Button>
          <Button variant="ghost" href="/donate/">Support SJS</Button>
          <Button variant="ghost" href="/volunteer/">Volunteer</Button>
        </div>
      </div>
      <figure>
        <FieldPhoto src="/assets/events/ck2026/outside-sanctuary-welcome-night.jpeg" alt="Safe Journey Sanctum volunteers welcoming guests at the sanctuary" eager sizes="(max-width: 767px) calc(100vw - 3rem), (max-width: 900px) calc(100vw - 4rem), (max-width: 1023px) calc((100vw - 4rem - 5vw) / 2.1), (max-width: 1360px) calc((100vw - 5rem - 5vw) / 2.1), 575px" />
        <figcaption>Cosmic Kinection 2026 · Astral Valley</figcaption>
      </figure>
    </div>
  </section>
  <section class="section">
    <div class="site-container split-grid">
      <div class="centered-copy">
        <p class="eyebrow">Model of care</p><h2>Calm space. Clear roles.</h2>
        <p class="lede">SJS volunteers are not therapists or medical providers and do not direct anyone's experience. The work is practical: listen well, reduce overwhelm, protect dignity, offer harm-reduction resources, and know when professional support should take over.</p>
        <Button variant="ghost" href="/model/">Explore the model</Button>
      </div>
      <dl class="principles centered-copy">{carePrinciples.map(principle => <div><dt>{principle.title}</dt><dd>{principle.text}</dd></div>)}</dl>
    </div>
  </section>
  <EmergencyNotice />
  {posts.length > 0 && <section class="section"><div class="site-container">
    <div class="section-heading"><h2>News and field notes</h2><Button variant="ghost" class="section-action" href="/news/">View all news</Button></div>
    <div class="news-list">{posts.map(post => <article class="centered-copy">
      <p class="post-meta">{formatDate(post.data.date, {month:"short", day:"numeric", year:"numeric"})}</p>
      <h3><a class="title-link" href={withBase("/news/" + post.id + "/")}>{post.data.title}</a></h3>
      <p>{post.data.description}</p>
    </article>)}</div>
  </div></section>}
</BaseLayout>
<style>
  .home-hero { padding: clamp(40px, 6vw, 80px) 0; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(28px, 5vw, 72px); }
  h1 { font-size: clamp(2.25rem, 4vw, 3.8rem); max-width: 18ch; margin: 18px auto; }
  .lede { margin: 24px auto; max-width: 58ch; }
  figure { margin: 0; }
  figure :global(img) { display: block; width: 100%; height: auto; border-radius: 8px; }
  figcaption { color: var(--muted); font-size: .85rem; margin-top: 12px; text-align: center; }
  .principles { margin: 0; }
  .principles div { padding: 20px 0; border-top: 1px solid var(--line); }
  dt { font-weight: 700; color: var(--ink); }
  dd { margin: 6px 0 0; color: var(--muted); }
  .news-list { display: grid; gap: 32px; max-width: 56rem; margin-inline: auto; }
  .news-list article { border-top: 1px solid var(--line); padding-top: 20px; }
  .news-list h3 { margin: 12px 0; }
  .news-list p { color: var(--muted); }
  @media(max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } h1 { max-width: 22ch; } }
</style>
