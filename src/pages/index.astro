---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import {
  carePrinciples,
  resources,
  site
} from "../data/site";
import { assetPath, withBase } from "../utils/paths";

const posts = (await getCollection("news"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const usesPostPlaceholder = (image: string) => image.endsWith("/sjslogo.png");

const actionPaths = [
  {
    icon: "map",
    title: "Planning an Event",
    text: "Add sanctuary peer support, practical harm reduction, and clear medical/security coordination to your care plan.",
    href: "/organizers/",
    label: "For Organizers"
  },
  {
    icon: "users",
    title: "Interested in Volunteering",
    text: "Learn the roles, training path, boundaries, and ways volunteers support sanctuary care and harm reduction.",
    href: "/volunteer/",
    label: "Volunteer With SJS"
  },
  {
    icon: "book",
    title: "Need Support or Resources",
    text: "Find clear guidance for preparation, difficult experiences, consent, crisis support, and integration.",
    href: "/resources/",
    label: "Read Resources"
  }
];

const heroFacts = [
  {
    icon: "home",
    title: "Sanctuary spaces",
    text: "Quiet, low-stimulation care areas."
  },
  {
    icon: "clipboard",
    title: "Trained volunteers",
    text: "Consent-first support and scope-aware care."
  },
  {
    icon: "cross",
    title: "Harm reduction",
    text: "Education and supplies when stocked."
  },
  {
    icon: "handshake",
    title: "Event partnerships",
    text: "Clear coordination with organizers."
  }
];
---

<BaseLayout title={site.name} description={site.description} image="/assets/sjs_home_background.png">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wide-container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Midwest peer support and harm reduction</p>
        <h1 id="home-title">Peer support and harm reduction for nonordinary states.</h1>
        <p>
          Safe Journey Sanctum helps Midwest events support people in nonordinary, intense, or overwhelming states with trained volunteers, low-stimulation spaces, practical harm-reduction education, and clear handoffs to medical or security teams when needed.
        </p>
        <div class="button-row hero-buttons" aria-label="Primary actions">
          <Button variant="amber" href={site.forms.partnership}>Partner With SJS</Button>
          <Button variant="ghost" href="/organizers/">For Organizers</Button>
          <Button variant="ghost" href="/volunteer/">Volunteer</Button>
        </div>
      </div>

      <div class="hero-facts" aria-label="SJS focus areas">
        {
          heroFacts.map((fact) => (
            <article>
              <span class="fact-icon" aria-hidden="true"><Icon name={fact.icon} /></span>
              <h3>{fact.title}</h3>
              <p>{fact.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section action-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2>Find the right path.</h2>
      </div>
      <div class="card-grid">
        {
          actionPaths.map((path) => (
            <Card icon={path.icon} class="service-card">
              <h3>{path.title}</h3>
              <p>{path.text}</p>
              <a href={withBase(path.href)}>{path.label}</a>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section model-preview">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Model of care</p>
        <h2>Calm space. Clear roles.</h2>
        <p class="lede">
          SJS volunteers are not therapists or medical providers and do not direct anyone's experience. The work is practical: listen well, reduce overwhelm, protect dignity, offer harm-reduction resources, and know when professional support should take over.
        </p>
        <div class="button-row">
          <Button variant="ghost" href="/model/">Explore the Model</Button>
          <Button variant="ghost" href="/faq/">Read FAQ</Button>
        </div>
      </div>
      <div class="principle-stack">
        {
          carePrinciples.map((principle) => (
            <Card icon={principle.icon} class="principle">
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight band support-band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Donate / support</p>
        <h2>Help stock and staff the sanctuary.</h2>
      </div>
      <div>
        <p>
          Contributions help fund soft flooring, blankets, lighting, hydration supplies, overdose education, volunteer training, signage, storage, transportation, and outreach materials.
        </p>
        <div class="button-row">
          <Button variant="amber" href="/donate/">Support SJS</Button>
          <Button variant="ghost" href={site.forms.wishlist}>In-kind Supplies</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section resource-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Practical resources</p>
        <h2>Plan, respond, and integrate.</h2>
      </div>
      <div class="card-grid">
        {
          resources.slice(0, 4).map((resource) => (
            <Card icon={resource.icon} class="resource-card">
              <h3>{resource.title}</h3>
              <p>{resource.text}</p>
              <a href={withBase(resource.href)}>Read more</a>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section latest-section">
    <div class="container">
      <div class="section-heading inline-heading">
        <div>
          <p class="eyebrow">News and field notes</p>
          <h2>Latest from SJS</h2>
        </div>
        <a href={withBase("/news/")}>View all news</a>
      </div>
      <div class="card-grid">
        {
          posts.map((post) => (
            <article class="surface post-card">
              {
                usesPostPlaceholder(post.data.image) ? (
                  <div class="post-card-placeholder" aria-hidden="true">
                    <Icon name="message" />
                  </div>
                ) : (
                  <img src={assetPath(post.data.image)} alt={post.data.imageAlt} loading="lazy" decoding="async" />
                )
              }
              <div class="post-card-body">
                <p class="post-meta">
                  {post.data.category} / {post.data.date.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric"
                  })}
                </p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <a href={withBase(`/news/${post.id}/`)} aria-label={`Read update: ${post.data.title}`}>Read update</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight social-band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Stay connected</p>
        <h2>Questions, partnerships, or volunteer interest.</h2>
      </div>
      <div class="button-row">
        <Button variant="ghost" href="/contact/">Contact SJS</Button>
        <Button variant="ghost" href={site.forms.volunteer}>Volunteer Form</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    min-height: 760px;
    overflow: hidden;
    position: relative;
  }

  .hero-image {
    background:
      linear-gradient(to right, rgb(13 9 18 / 0.95), rgb(21 16 29 / 0.8), rgb(21 16 29 / 0.45)),
      var(--sjs-home-bg-url);
    background-position: center;
    background-size: cover;
    inset: 0;
    position: absolute;
  }

  .hero-scrim {
    background:
      linear-gradient(180deg, transparent 78%, var(--paper) 100%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 96px);
    inset: 0;
    position: absolute;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    justify-content: center;
    min-height: 760px;
    padding-bottom: 64px;
    padding-top: 96px;
    position: relative;
  }

  .hero-copy {
    align-self: center;
    color: white;
    margin-right: auto;
    max-width: 48rem;
  }

  .hero-copy h1 {
    color: white;
    margin: 16px 0 22px;
    max-width: min(100%, 13.5em);
    font-size: clamp(2.45rem, 7.8vw, 4rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  .hero-copy p:not(.eyebrow) {
    color: rgb(255 255 255 / 0.84);
    font-size: 1.2rem;
    line-height: 1.75;
    max-width: 40rem;
  }

  .home-hero .eyebrow {
    color: var(--amber);
  }

  .hero-buttons {
    margin-top: 32px;
    max-width: 48rem;
  }

  .hero-facts {
    align-self: stretch;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: none;
  }

  .hero-facts article {
    background: rgb(255 255 255 / 0.05);
    border: 1px solid var(--line);
    border-radius: 8px;
    backdrop-filter: blur(14px);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    min-height: 112px;
    padding: 18px;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .hero-facts article:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.24);
    box-shadow: 0 18px 46px rgb(0 0 0 / 0.18);
    transform: translateY(-2px);
  }

  .fact-icon {
    align-items: center;
    background: rgb(242 160 68 / 0.14);
    border: 1px solid rgb(242 160 68 / 0.26);
    border-radius: 8px;
    color: var(--amber);
    display: inline-flex;
    height: 34px;
    justify-content: center;
    margin-bottom: 12px;
    width: 34px;
  }

  .fact-icon :global(svg) {
    height: 18px;
    width: 18px;
  }

  .hero-facts h3 {
    color: var(--sjs-text);
    font-family: "Source Sans 3", Aptos, "Segoe UI", sans-serif;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.2;
    margin: 0 0 6px;
  }

  .hero-facts p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  :global(html[data-theme="light"]) .hero-image {
    background:
      linear-gradient(to right, rgb(33 23 39 / 0.9), rgb(53 32 63 / 0.66), rgb(53 32 63 / 0.34)),
      var(--sjs-home-bg-url);
    background-position: center;
    background-size: cover;
  }

  :global(html[data-theme="light"]) .hero-scrim {
    background:
      linear-gradient(180deg, transparent 70%, rgb(251 248 242 / 0.3) 88%, var(--paper) 100%),
      repeating-linear-gradient(90deg, rgba(82, 62, 96, 0.05) 0 1px, transparent 1px 96px);
  }

  :global(html[data-theme="light"]) .hero-facts article {
    background: rgb(255 253 249 / 0.88);
    border-color: rgb(82 62 96 / 0.22);
    box-shadow: 0 16px 44px rgb(55 41 67 / 0.16);
  }

  :global(html[data-theme="light"]) .hero-facts h3 {
    color: var(--sjs-purple-dark);
  }

  :global(html[data-theme="light"]) .hero-facts p {
    color: #463a4f;
  }

  .section-heading {
    margin-bottom: 36px;
    max-width: 52rem;
  }

  .section-heading h2 {
    margin: 8px 0 0;
  }

  .inline-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    max-width: none;
  }

  .service-card h3,
  .resource-card h3 {
    margin: 0 0 12px;
  }

  .service-card p,
  .resource-card p {
    color: var(--muted);
    margin-bottom: 18px;
  }

  .model-preview {
    background: var(--sjs-bg-soft);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    position: relative;
  }

  .model-preview::before,
  .social-band::before {
    background: var(--sjs-logo-url) center / contain no-repeat;
    content: "";
    height: 32rem;
    opacity: 0.03;
    pointer-events: none;
    position: absolute;
    width: 32rem;
  }

  .model-preview::before {
    bottom: -14rem;
    left: -10rem;
  }

  .model-preview > .container,
  .social-band > .container {
    position: relative;
  }

  .model-preview .lede {
    max-width: 42rem;
    margin: 18px 0 24px;
  }

  .principle-stack {
    display: grid;
    gap: 12px;
  }

  .principle {
    padding: 22px;
  }

  .principle h3 {
    margin: 0 0 8px;
  }

  .principle p {
    color: var(--muted);
  }

  .support-band .button-ghost {
    background: var(--button-ghost-bg);
    color: var(--band-text);
  }

  .post-meta {
    color: var(--moss);
    font-size: 0.84rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .post-card h3 {
    margin: 0;
  }

  .post-card p:not(.post-meta) {
    color: var(--muted);
  }

  .social-band {
    background: var(--linen);
    border-top: 1px solid var(--line);
    overflow: hidden;
    position: relative;
  }

  .social-band::before {
    right: -12rem;
    top: -14rem;
  }

  @media (max-width: 820px) {
    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inline-heading {
      align-items: flex-start;
      display: grid;
      gap: 12px;
    }
  }

  @media (max-width: 560px) {
    .home-hero {
      min-height: auto;
    }

    .hero-inner {
      min-height: 740px;
      padding-bottom: 44px;
      padding-top: 54px;
    }

    .hero-copy h1 {
      font-size: clamp(2.2rem, 11vw, 2.8rem);
      line-height: 1.04;
    }

    .hero-facts {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) {
    .hero-copy h1 {
      font-size: clamp(3rem, 5.4vw, 3.75rem);
    }
  }

  @media (min-width: 1024px) {
    .hero-copy h1 {
      font-size: clamp(3.35rem, 4.2vw, 4rem);
    }

    .action-section {
      padding-top: 88px;
    }
  }
</style>
