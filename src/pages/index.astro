---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EmergencyNotice from "../components/EmergencyNotice.astro";
import FieldPhoto from "../components/FieldPhoto.astro";
import Button from "../components/ui/Button.astro";
import { carePrinciples, site } from "../data/site";
import { withBase } from "../utils/paths";
import { formatDate } from "../utils/dates";
const posts = (await getCollection("news"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout title={site.name} image="/assets/events/ck2026/team_portrait.jpeg">
  <section class="home-hero">
    <div class="site-container hero-grid">
      <div class="centered-copy">
        <p class="eyebrow">Peer support at Midwest events</p>
        <h1>Help us care for people at events</h1>
        <p class="lede">Our volunteers offer a quiet place and someone to listen at festivals, concerts and community events. We support people in nonordinary states, share harm reduction information and work with event medical and security teams when guests need more help.</p>
        <div class="button-row" role="group" aria-label="Primary actions">
          <Button variant="amber" href="/volunteer/">Volunteer with SJS</Button>
          <Button variant="ghost" href="/organizers/">Bring SJS to your event</Button>
        </div>
        <p class="support-link">Looking for support? <a href={withBase("/faq/#getting-support")}>What to expect at the sanctuary</a></p>
      </div>
      <figure>
        <FieldPhoto src="/assets/events/ck2026/team_portrait.jpeg" alt="SJS volunteers gathered inside the sanctuary tent at Cosmic Kinection" eager sizes="(max-width: 440px) calc(100vw - 3rem), 392px" />
        <figcaption>Our team at Cosmic Kinection 2026, Astral Valley</figcaption>
      </figure>
    </div>
  </section>
  <section class="section">
    <div class="site-container split-grid">
      <div class="centered-copy">
        <h2>What to expect at the sanctuary</h2>
        <p class="lede">Volunteers listen without judgment and ask what would help. You can take a break from the crowd or ask about harm reduction supplies. We offer peer support; medical care and therapy are outside our role.</p>
        <Button variant="ghost" href="/model/">See how we work</Button>
      </div>
      <dl class="principles centered-copy">{carePrinciples.map(principle => <div><dt>{principle.title}</dt><dd>{principle.text}</dd></div>)}</dl>
    </div>
  </section>
  <section class="section-tight volunteer-band" aria-labelledby="join-title">
    <div class="site-container split-grid">
      <div>
        <p class="eyebrow">Join the team</p>
        <h2 id="join-title">There’s a role for you</h2>
      </div>
      <div class="prose">
        <p>You don’t need to be a therapist or medical professional. We need people who listen, respect boundaries and ask for backup. You can also help with supplies, logistics, outreach or training between events.</p>
        <p>Apply through Heartland Transpersonal Alliance and select Safe Journey Sanctum. Volunteers complete onboarding and practice before taking a shift.</p>
        <Button variant="amber" href={site.forms.volunteer}>Open volunteer application</Button>
      </div>
    </div>
  </section>
  <EmergencyNotice />
  {posts.length > 0 && <section class="section"><div class="site-container">
    <div class="section-heading"><h2>News and field notes</h2><Button variant="ghost" class="section-action" href="/news/">View all news</Button></div>
    <div class="news-list">{posts.map(post => <article class="centered-copy">
      <p class="post-meta">{formatDate(post.data.date, {month:"short", day:"numeric", year:"numeric"})}</p>
      <h3><a class="title-link" href={withBase("/news/" + post.id + "/")}>{post.data.title}</a></h3>
      <p>{post.data.description}</p>
    </article>)}</div>
  </div></section>}
</BaseLayout>
<style>
  .home-hero { padding: clamp(40px, 6vw, 80px) 0; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(28px, 5vw, 72px); }
  h1 { max-width: 20ch; margin: 8px 0 0; }
  .lede { margin: 14px 0 20px; max-width: 58ch; }
  figure { margin: 0; width: min(100%, 392px); justify-self: center; }
  figure :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; }
  figcaption { color: var(--muted); font-size: .85rem; margin-top: 12px; text-align: center; }
  .support-link { color: var(--muted); margin-top: 20px; font-size: 1rem; }
  .support-link a { text-decoration: underline; text-underline-offset: .2em; }
  .volunteer-band { background: var(--linen); border-block: 1px solid var(--line); }
  .principles { margin: 0; }
  .principles div { padding: 20px 0; border-top: 1px solid var(--line); }
  dt { font-weight: 700; color: var(--ink); }
  dd { margin: 6px 0 0; color: var(--muted); }
  .news-list { display: grid; gap: 32px; max-width: 56rem; margin-inline: auto; }
  .news-list article { border-top: 1px solid var(--line); padding-top: 20px; }
  .news-list h3 { margin: 12px 0; }
  .news-list p { color: var(--muted); }
  @media(max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
