---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import FieldPhoto from "../components/FieldPhoto.astro";
import { site } from "../data/site";

const contactPaths = [
  {
    icon: "handshake",
    title: "Event partnership",
    text: "Share the event date, location, expected attendance, venue setup, medical/security plan, and support requested.",
    href: site.forms.partnership,
    label: "Email Partnership Details"
  },
  {
    icon: "message",
    title: "General questions",
    text: "Ask about SJS, volunteering, education, donations, resources, or community collaboration.",
    href: site.forms.contact,
    label: "Email SJS"
  }
];
---

<BaseLayout title="Contact" description="Contact SJS for event partnership, volunteer, donation, and general inquiries.">
  <PageHero
    eyebrow="Contact"
    title="Contact SJS."
    text="For on-site emergencies, contact venue medical or security personnel immediately. For planning and non-urgent questions, use the paths below."
    art="contact"
    compact
  />

  <section class="section">
    <div class="site-container contact-layout">
      <div class="contact-paths">
        {
          contactPaths.map((path) => (
            <Card icon={path.icon} class="service-card">
              <h2>{path.title}</h2>
              <p>{path.text}</p>
              <Button variant="ghost" size="sm" href={path.href} ariaLabel={`${path.label}: ${path.title}`}>{path.label}</Button>
            </Card>
          ))
        }
      </div>
      <FieldPhoto class="contact-photo" src="/assets/events/ck2026/team_portrait.jpeg" alt="Safe Journey Sanctum volunteers gathered together inside the sanctuary tent" sizes="(max-width: 767px) calc(100vw - 3rem), (max-width: 900px) calc(100vw - 4rem), (max-width: 1360px) 40vw, 511px" />
    </div>
  </section>

  <section class="section-tight">
    <div class="site-container notice">
      During festivals and events, the sanctuary team can be reached on site through venue staff, security, or production. If someone may be medically unsafe, seek medical support first.
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr); gap: 40px; align-items: start; }
  .contact-paths { display: grid; gap: 24px; }
  :global(.contact-photo) { width: 100%; height: auto; border-radius: 12px; }
  @media (max-width: 900px) { .contact-layout { grid-template-columns: 1fr; } }

  .service-card h2 {
    font-size: 1.22rem;
    margin: 0 0 10px;
  }

  .service-card p {
    color: var(--muted);
    margin-bottom: 16px;
  }

  .service-card :global(.button) {
    align-self: flex-start;
    margin-top: auto;
    overflow-wrap: anywhere;
  }
</style>
