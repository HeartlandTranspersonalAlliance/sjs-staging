---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import { site, trainingTopics } from "../data/site";

const roles = [
  { icon: "heart", title: "Peer counselors" },
  { icon: "book", title: "Harm-reduction educators" },
  { icon: "handshake", title: "Event liaisons" },
  { icon: "package", title: "Logistics coordinators" },
  { icon: "gift", title: "Outreach and fundraising helpers" },
  { icon: "clipboard", title: "Training support volunteers" }
];
---

<BaseLayout title="Volunteer" description="Volunteer roles, expectations, training topics, and application information for SJS.">
  <PageHero
    eyebrow="Volunteer"
    title="Join the volunteer community that makes sanctuary possible."
    text="You do not need to be a therapist or medical professional to get involved. Compassion, steadiness, and the willingness to listen are at the heart of SJS peer support."
    art="training"
  />

  <section class="section">
    <div class="container two-grid">
      <div class="prose">
        <h2>What volunteers do</h2>
        <p>
          Volunteers staff comfortable, well-lit sanctuary spaces where guests can rest, talk, hydrate, draw, breathe, or sit quietly. SJS volunteers offer presence rather than advice and know when to involve medical personnel or security.
        </p>
        <p>
          Between events, volunteers help with outreach, fundraising, training facilitation, supply prep, documentation, and logistics.
        </p>
        <Button variant="primary" href={site.forms.volunteer}>Volunteer Application Form</Button>
      </div>
      <Card icon="users" class="service-card">
        <h3>Roles include</h3>
        <ul class="roles-list">
          {roles.map((role) => (
            <li>
              <span aria-hidden="true"><Icon name={role.icon} /></span>
              {role.title}
            </li>
          ))}
        </ul>
      </Card>
    </div>
  </section>

  <section class="section-tight training-strip">
    <div class="container">
      <p class="eyebrow">Training topics</p>
      <h2>Prepared volunteers make the space safer.</h2>
      <ul class="topic-list">
        {trainingTopics.map((topic) => <li>{topic}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight volunteer-cta">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Keep learning</p>
        <h2>See how volunteer training is structured.</h2>
      </div>
      <div class="prose">
        <p>
          Training gives volunteers a shared baseline for consent-first support, practical escalation, and calm teamwork before stepping into an event environment.
        </p>
        <div class="button-row">
          <Button variant="ghost" href="/training/">Learn about Training</Button>
          <Button variant="ghost" href="/faq/">Read FAQ</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-strip {
    background: var(--linen);
    border-top: 1px solid var(--line);
  }

  .training-strip h2 {
    margin: 8px 0 22px;
  }

  .topic-list {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-list li {
    align-items: center;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    display: flex;
    font-size: 0.9rem;
    font-weight: 800;
    gap: 10px;
    min-height: 52px;
    padding: 12px 14px;
  }

  .topic-list li::before {
    background: var(--amber);
    border-radius: 999px;
    content: "";
    flex: 0 0 auto;
    height: 8px;
    width: 8px;
  }

  .roles-list {
    display: grid;
    gap: 12px;
    list-style: none;
    padding-left: 0;
  }

  .roles-list li + li {
    margin-top: 0;
  }

  .roles-list li {
    align-items: flex-start;
    display: flex;
    gap: 10px;
  }

  .roles-list span {
    align-items: center;
    background: var(--icon-bg);
    border: 1px solid var(--icon-border);
    border-radius: 8px;
    color: var(--icon-text);
    display: inline-flex;
    flex: 0 0 auto;
    height: 32px;
    justify-content: center;
    width: 32px;
  }

  .roles-list span :global(svg) {
    height: 17px;
    width: 17px;
  }

  @media (min-width: 640px) {
    .roles-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .volunteer-cta {
    border-top: 1px solid var(--line);
  }
</style>
