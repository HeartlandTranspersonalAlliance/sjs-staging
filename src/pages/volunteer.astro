---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import { site, trainingTopics } from "../data/site";

const roles = [
  { icon: "heart", title: "Peer support volunteers" },
  { icon: "book", title: "Harm-reduction educators" },
  { icon: "handshake", title: "Event liaisons" },
  { icon: "package", title: "Logistics coordinators" },
  { icon: "gift", title: "Outreach and fundraising helpers" },
  { icon: "clipboard", title: "Training support volunteers" }
];

const expectations = [
  "Be sober and fit for duty during SJS shifts.",
  "Know who the shift lead is and ask for backup early.",
  "Ask for consent before offering support and default to no touch.",
  "Stay within your peer-support role. Bring in the appropriate team promptly for medical or safety concerns.",
  "Protect guests’ privacy. Once a situation is stable, record significant incidents and stick to what happened."
];

const trainingFlow = [
  {
    icon: "clipboard",
    title: "Onboarding",
    text: "Learn your role, what you’re expected to do, the limits of confidentiality and how we work with event teams."
  },
  {
    icon: "message",
    title: "Practice",
    text: "Practice asking for consent, grounding without touch, de-escalation, documenting incidents and handing off to another team."
  },
  {
    icon: "map",
    title: "At the event",
    text: "At the briefing, review shift duties, supplies, breaks and how to call for help. After the event, meet to review how it went."
  }
];
---

<BaseLayout title="Volunteer" description="Volunteer roles, expectations, training topics, and application information for SJS.">
  <PageHero
    title="Volunteer with Safe Journey Sanctum"
    text="You don’t need to be a therapist or medical professional. We’re looking for people who listen, respect boundaries, follow the team’s procedures and ask for backup early."
    art="training"
  />

  <section class="section">
    <div class="site-container two-grid">
      <div class="prose">
        <h2>What volunteers do</h2>
        <p>
          Volunteers staff a quiet sanctuary where guests can rest, have water, talk or draw. Depending on your role and training, you might also help with education, supplies or event logistics.
        </p>
        <p>
          During shifts, volunteers listen without giving advice and bring in medical or security staff when needed. Between events, volunteers can help with outreach, fundraising, training, supplies, documentation or logistics.
        </p>
        <Button variant="primary" href={site.forms.volunteer}>Open volunteer application</Button>
      </div>
      <Card icon="users" class="service-card">
        <h2>Volunteer roles</h2>
        <ul class="roles-list">
          {roles.map((role) => (
            <li>
              <span aria-hidden="true"><Icon name={role.icon} /></span>
              {role.title}
            </li>
          ))}
        </ul>
      </Card>
    </div>
  </section>

  <section class="section-tight training-strip">
    <div class="site-container">
      <div class="section-heading">
        <h2>How we prepare volunteers</h2>
      </div>
      <div class="card-grid training-flow-grid">
        {
          trainingFlow.map((step) => (
            <article class="surface service-card">
              <span class="card-icon" aria-hidden="true"><Icon name={step.icon} /></span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
      <h3 class="topic-heading">Core topics</h3>
      <ul class="topic-list" role="list">
        {trainingTopics.map((topic) => <li>{topic}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="site-container split-grid">
      <div>
        <h2>What we expect on a shift</h2>
      </div>
      <ul class="content-list">
        {expectations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight volunteer-cta">
    <div class="site-container split-grid">
      <div>
        <h2>How to apply</h2>
      </div>
      <div class="prose">
        <p>
          In the Heartland Transpersonal Alliance application, select Safe Journey Sanctum. Tell us what you’d like to do and about any relevant experience.
        </p>
        <div class="button-row">
          <Button variant="primary" href={site.forms.volunteer}>Open volunteer application</Button>
          <Button variant="ghost" href="/faq/">Read the FAQ</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-strip {
    background: var(--linen);
    border-top: 1px solid var(--line);
  }

  .training-flow-grid {
    margin-bottom: 28px;
  }

  .training-flow-grid h3 {
    font-size: 1.18rem;
    margin: 0 0 8px;
  }

  .training-flow-grid p {
    color: var(--muted);
  }

  .topic-heading {
    font-family: "Source Sans 3", Aptos, "Segoe UI", sans-serif;
    font-size: 1rem;
    font-weight: 900;
    margin: 0 0 14px;
  }

  .topic-list {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-list li {
    align-items: center;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    display: flex;
    font-size: 1rem;
    font-weight: 800;
    gap: 10px;
    min-height: 52px;
    padding: 12px 14px;
  }

  .topic-list li::before {
    background: var(--amber);
    border-radius: 999px;
    content: "";
    flex: 0 0 auto;
    height: 8px;
    width: 8px;
  }

  .roles-list {
    display: grid;
    gap: 12px;
    list-style: none;
    padding-left: 0;
  }

  .roles-list li + li {
    margin-top: 0;
  }

  .roles-list li {
    align-items: flex-start;
    display: flex;
    gap: 10px;
  }

  .roles-list span {
    align-items: center;
    background: var(--icon-bg);
    border: 1px solid var(--icon-border);
    border-radius: 8px;
    color: var(--icon-text);
    display: inline-flex;
    flex: 0 0 auto;
    height: 32px;
    justify-content: center;
    width: 32px;
  }

  .roles-list span :global(svg) {
    height: 17px;
    width: 17px;
  }

  @media (min-width: 640px) {
    .roles-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .volunteer-cta {
    border-top: 1px solid var(--line);
  }
</style>
