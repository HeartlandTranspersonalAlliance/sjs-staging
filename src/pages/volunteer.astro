---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import { site, trainingTopics } from "../data/site";

const roles = [
  { icon: "heart", title: "Peer counselors" },
  { icon: "book", title: "Harm-reduction educators" },
  { icon: "handshake", title: "Event liaisons" },
  { icon: "package", title: "Logistics coordinators" },
  { icon: "gift", title: "Outreach and fundraising helpers" },
  { icon: "clipboard", title: "Training support volunteers" }
];

const expectations = [
  "Be sober and fit for duty during SJS shifts.",
  "Know who the shift lead is and ask for backup early.",
  "Use consent-first support and default to no touch.",
  "Stay within peer-support scope and escalate medical or safety concerns promptly.",
  "Protect privacy and document significant incidents factually after the situation is stable."
];

const trainingFlow = [
  {
    icon: "clipboard",
    title: "Onboarding",
    text: "Mission, role boundaries, confidentiality limits, volunteer expectations, and how SJS integrates with event care teams."
  },
  {
    icon: "message",
    title: "Practice",
    text: "Scenario practice for consent-first communication, non-touch grounding, de-escalation, documentation, and warm handoffs."
  },
  {
    icon: "map",
    title: "Deployment",
    text: "Event briefing, shift expectations, supplies, escalation pathways, breaks, and post-event debrief."
  }
];
---

<BaseLayout title="Volunteer" description="Volunteer roles, expectations, training topics, and application information for SJS.">
  <PageHero
    eyebrow="Volunteer"
    title="Join the volunteer community that makes sanctuary possible."
    text="You do not need to be a therapist or medical professional to get involved. SJS needs steady people who can listen, follow protocol, respect boundaries, and ask for help early."
    art="training"
  />

  <section class="section">
    <div class="container two-grid">
      <div class="prose">
        <h2>What volunteers do</h2>
        <p>
          Volunteers staff comfortable, low-stimulation sanctuary spaces where guests can rest, talk, hydrate, draw, breathe, or sit quietly. SJS volunteers offer calm presence rather than advice and know when to involve medical personnel or security.
        </p>
        <p>
          Between events, volunteers help with outreach, fundraising, training facilitation, supply prep, documentation, and logistics.
        </p>
        <Button variant="primary" href={site.forms.volunteer}>Volunteer Application Form</Button>
      </div>
      <Card icon="users" class="service-card">
        <h3>Roles include</h3>
        <ul class="roles-list">
          {roles.map((role) => (
            <li>
              <span aria-hidden="true"><Icon name={role.icon} /></span>
              {role.title}
            </li>
          ))}
        </ul>
      </Card>
    </div>
  </section>

  <section class="section-tight training-strip">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Training expectations</p>
        <h2>Prepared volunteers make the space safer.</h2>
      </div>
      <div class="card-grid training-flow-grid">
        {
          trainingFlow.map((step) => (
            <article class="surface service-card">
              <span class="card-icon" aria-hidden="true"><Icon name={step.icon} /></span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
      <h3 class="topic-heading">Core topics</h3>
      <ul class="topic-list">
        {trainingTopics.map((topic) => <li>{topic}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Shift expectations</p>
        <h2>Good support is calm, bounded, and team-based.</h2>
      </div>
      <ul class="expectation-list">
        {expectations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight volunteer-cta">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Apply</p>
        <h2>Start with the volunteer application.</h2>
      </div>
      <div class="prose">
        <p>
          The application helps SJS understand your experience, availability, training background, accommodations, and whether a leadership role may be appropriate.
        </p>
        <div class="button-row">
          <Button variant="primary" href={site.forms.volunteer}>Volunteer Application Form</Button>
          <Button variant="ghost" href="/faq/">Read FAQ</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-strip {
    background: var(--linen);
    border-top: 1px solid var(--line);
  }

  .training-flow-grid {
    margin-bottom: 28px;
  }

  .training-flow-grid h3 {
    font-size: 1.18rem;
    margin: 0 0 8px;
  }

  .training-flow-grid p {
    color: var(--muted);
  }

  .topic-heading {
    font-family: "Source Sans 3", Aptos, "Segoe UI", sans-serif;
    font-size: 1rem;
    font-weight: 900;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .topic-list {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-list li {
    align-items: center;
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    display: flex;
    font-size: 0.9rem;
    font-weight: 800;
    gap: 10px;
    min-height: 52px;
    padding: 12px 14px;
  }

  .topic-list li::before {
    background: var(--amber);
    border-radius: 999px;
    content: "";
    flex: 0 0 auto;
    height: 8px;
    width: 8px;
  }

  .roles-list {
    display: grid;
    gap: 12px;
    list-style: none;
    padding-left: 0;
  }

  .roles-list li + li {
    margin-top: 0;
  }

  .roles-list li {
    align-items: flex-start;
    display: flex;
    gap: 10px;
  }

  .roles-list span {
    align-items: center;
    background: var(--icon-bg);
    border: 1px solid var(--icon-border);
    border-radius: 8px;
    color: var(--icon-text);
    display: inline-flex;
    flex: 0 0 auto;
    height: 32px;
    justify-content: center;
    width: 32px;
  }

  .roles-list span :global(svg) {
    height: 17px;
    width: 17px;
  }

  .expectation-list {
    color: var(--muted);
    line-height: 1.75;
    margin: 0;
    padding-left: 1.15rem;
  }

  .expectation-list li + li {
    margin-top: 0.55rem;
  }

  @media (min-width: 640px) {
    .roles-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .volunteer-cta {
    border-top: 1px solid var(--line);
  }
</style>
