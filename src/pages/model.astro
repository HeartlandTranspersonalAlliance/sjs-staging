---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Card from "../components/ui/Card.astro";
import IconBadge from "../components/ui/IconBadge.astro";
import { carePrinciples, eventServices } from "../data/site";
import { assetPath } from "../utils/paths";
---

<BaseLayout
  title="Our Model of Care"
  description="The SJS approach to sanctuary setup, volunteer boundaries, escalation, and consent-first peer support."
  image="/assets/blog/dale-patrick.jpg"
>
  <PageHero
    eyebrow="Our model"
    title="A practical care model for nonordinary states at events."
    text="SJS combines comfortable sanctuary environments, trained peer presence, harm-reduction education, practical supplies, and coordination with professional medical and security teams."
    image="/assets/blog/dale-patrick.jpg"
    imageAlt="Event outreach with Narcan education and SJS volunteers"
    imagePosition="center 34%"
  />

  <section class="section">
    <div class="container card-grid model-principles">
      {
        carePrinciples.map((principle) => (
          <Card icon={principle.icon} class="service-card principle-card">
            <h2>{principle.title}</h2>
            <p>{principle.text}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="section-tight model-band">
    <div class="container split-grid">
      <div class="prose">
        <p class="eyebrow">Sanctuary setup</p>
        <h2>Comfortable, stocked, and easy to find.</h2>
        <p>
          SJS sanctuaries are designed to be inviting and useful: soft floors, pillows, cushions, blankets, gentle light, books, art supplies, grounding objects, and harm-reduction supplies when stocked. The goal is to lower stimulation while protecting privacy, dignity, and access to help.
        </p>
      </div>
      <img class="model-image" src={assetPath("/assets/sjs_home_background.png")} alt="Calm outdoor sanctuary space at dusk" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="section">
    <div class="container two-grid">
      <div class="prose">
        <IconBadge name="ear" />
        <p class="eyebrow">Volunteer boundaries</p>
        <h2>Presence without steering.</h2>
        <p>
          Volunteers are not therapists. They listen, ask permission, help reduce overwhelm, and avoid interpreting or steering what a guest is experiencing. If a situation requires medical, security, or crisis support, the volunteer brings in the right help clearly and quickly.
        </p>
      </div>
      <Card icon="map" class="service-card">
        <h3>Event coordination includes</h3>
        <ul>
          {eventServices.map((service) => <li>{service}</li>)}
        </ul>
      </Card>
    </div>
  </section>
</BaseLayout>

<style>
  .model-band {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .model-principles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .principle-card {
    min-height: 210px;
  }

  .model-image {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow:
      0 20px 60px var(--shadow),
      0 0 0 8px rgb(169 112 221 / 0.08);
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 760px) {
    .model-principles {
      grid-template-columns: 1fr;
    }
  }
</style>
