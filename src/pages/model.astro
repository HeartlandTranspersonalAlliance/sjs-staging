---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Card from "../components/ui/Card.astro";
import IconBadge from "../components/ui/IconBadge.astro";
import { carePrinciples, eventServices } from "../data/site";
import FieldPhoto from "../components/FieldPhoto.astro";
---

<BaseLayout
  title="Our Model of Care"
  description="The SJS approach to sanctuary setup, volunteer boundaries, escalation, and consent-first peer support."
  image="/assets/blog/dale-patrick.jpg"
>
  <PageHero
    title="How we support people at events"
    text="We set up a quiet sanctuary for people in nonordinary states. Trained volunteers offer peer support and harm-reduction education, share supplies when stocked, and coordinate with the event’s medical and security teams."
    image="/assets/blog/dale-patrick.jpg"
    imageAlt="Event outreach with Narcan education and SJS volunteers"
    imagePosition="center 34%"
  />

  <section class="section">
    <div class="site-container card-grid model-principles">
      {
        carePrinciples.map((principle) => (
          <Card icon={principle.icon} class="service-card principle-card">
            <h2>{principle.title}</h2>
            <p>{principle.text}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="section-tight model-band">
    <div class="site-container split-grid">
      <div class="prose">
        <h2>Inside the sanctuary</h2>
        <p>
          We set up soft flooring, pillows and blankets under gentle lighting. Guests can use books, art supplies or grounding objects. We stock harm-reduction supplies when available and keep the area easy to find while protecting guests’ privacy.
        </p>
      </div>
      <FieldPhoto class="model-image" src="/assets/events/ck2026/inside-sanctuary-day.jpeg" alt="Blankets and resting spaces inside the SJS sanctuary during the day" />
    </div>
  </section>

  <section class="section">
    <div class="site-container two-grid">
      <div class="prose">
        <IconBadge name="ear" />
        <h2>What volunteers do</h2>
        <p>
          Volunteers listen, ask permission and help reduce stimulation without interpreting or directing a guest’s experience. They are not therapists. If a guest needs medical, security or crisis support, volunteers contact the appropriate team promptly.
        </p>
      </div>
      <Card icon="map" class="service-card">
        <h2>How we work with event teams</h2>
        <ul class="content-list">
          {eventServices.map((service) => <li>{service}</li>)}
        </ul>
      </Card>
    </div>
  </section>
</BaseLayout>

<style>
  .model-band {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .model-principles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .principle-card {
    min-height: 210px;
  }

  :global(.model-image) {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow:
      0 20px 60px var(--shadow),
      0 0 0 8px rgb(169 112 221 / 0.08);
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 760px) {
    .model-principles {
      grid-template-columns: 1fr;
    }
  }
</style>
