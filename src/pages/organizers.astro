---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { eventServices, site } from "../data/site";
import { withBase } from "../utils/paths";

const setupNeeds = [
  "A quiet, visible location that medical and security teams can reach",
  "Power or batteries for lighting and equipment",
  "Shade, weather protection and suitable flooring",
  "A production contact, a radio channel and a plan for calling for help",
  "A layout that gives guests privacy without isolating volunteers"
];

const planningInputs = [
  "Event date, venue, expected attendance, age policy, and event type",
  "Existing medical, security, ranger, production, and venue contacts",
  "Sanctuary hours and location, nearby water and bathrooms, and emergency access",
  "Known heat, weather, crowd, substance, accessibility, or venue-specific risks",
  "Whether fentanyl reagent testing is requested, plus the event approval and local requirements that apply",
  "How teams should communicate about sensitive handoffs: radio, phone or in person"
];

const boundaries = [
  "We offer peer support, grounding and harm-reduction education. We share supplies when stocked and connect guests with other event teams when needed.",
  "Fentanyl reagent testing is an additional service. We plan it with organizers based on event approval, local requirements, staffing and supplies.",
  "We do not diagnose or treat medical conditions, provide psychotherapy, or act as security or law enforcement.",
  "If a guest may be medically unsafe, event medical or emergency response should be contacted first."
];

---

<BaseLayout title="For Event Organizers" description="SJS services, staffing model, setup needs, coordination, and partnership inquiry information for event organizers.">
  <PageHero
    title="Peer support for your event"
    text="We run a quiet sanctuary and provide peer support and harm-reduction education. We plan our work with your medical, security, ranger, venue and operations teams."
    art="organizers"
  />

  <section class="section">
    <div class="site-container organizer-intro">
      <div class="prose">
        <h2>Plan with us before doors open</h2>
        <p>
          Before the event, agree on who handles each kind of request, how teams contact each other and when to call for help. That makes it easier to respond promptly and avoid sending two teams to the same call.
        </p>
      </div>
      <a class="button button-primary" href={site.forms.partnership}>Email about your event</a>
    </div>
  </section>

  <section class="section-tight organizer-band">
    <div class="site-container two-grid">
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="home" /></span>
        <h2>What we provide</h2>
        <ul class="content-list">
          {eventServices.map((service) => <li>{service}</li>)}
        </ul>
      </div>
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="shield" /></span>
        <h2>Where our role ends</h2>
        <ul class="content-list">
          {boundaries.map((boundary) => <li>{boundary}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container two-grid">
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="clipboard" /></span>
        <h2>What the sanctuary needs</h2>
        <ul class="content-list">
          {setupNeeds.map((need) => <li>{need}</li>)}
        </ul>
      </div>
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="map" /></span>
        <h2>What to share with us</h2>
        <ul class="content-list">
          {planningInputs.map((input) => <li>{input}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight battle-card">
    <div class="site-container split-grid">
      <div>
        <h2>How the services fit together</h2>
      </div>
      <div class="prose">
        <p>
          See what it takes to run a sanctuary alongside your event’s other services.
        </p>
        <a class="button button-ghost" href={withBase("/why-sjs/")}>Why bring in SJS?</a>
      </div>
    </div>
  </section>

  <section class="section-tight band">
    <div class="site-container split-grid">
      <div>
        <h2>Working with professional responders</h2>
      </div>
      <div class="prose">
        <p>
          We plan staffing and hours around event size, operating hours, risks, available space and existing medical and security coverage. Volunteers work alongside professional responders and do not replace them. When there is injury, abnormal breathing, overdose concern, heat illness, severe agitation, violence, suicidality, or uncertainty about medical risk, SJS escalates rather than trying to hold the situation internally.
        </p>
        <a class="button button-primary" href={site.forms.partnership}>Email about your event</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-card h2 {
    font-size: 1.22rem;
    margin: 0 0 12px;
  }

  .organizer-intro {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .organizer-intro .button {
    justify-self: end;
  }

  .organizer-band {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .battle-card {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .organizer-intro {
      grid-template-columns: 1fr;
    }

    .organizer-intro .button {
      justify-self: start;
    }
  }
</style>
