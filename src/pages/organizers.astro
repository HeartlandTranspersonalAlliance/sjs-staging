---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { eventServices, site } from "../data/site";

const setupNeeds = [
  "Quiet, visible location with clear access for medical/security teams",
  "Power or battery plan for gentle lighting and operations",
  "Shade, weather protection, and practical flooring",
  "Production contact, radio/channel plan, and escalation protocol",
  "Privacy-aware guest flow that does not isolate volunteers"
];

const planningInputs = [
  "Event date, venue, expected attendance, age policy, and event type",
  "Existing medical, security, ranger, production, and venue contacts",
  "SJS operating hours, location, nearby water/bathrooms, and emergency access",
  "Known heat, weather, crowd, substance, accessibility, or venue-specific risks",
  "Preferred radio, phone, or runner process for sensitive handoffs"
];

const boundaries = [
  "SJS offers peer support, grounding, harm-reduction education, practical supplies when stocked, and warm handoffs.",
  "SJS does not provide medical diagnosis, medical treatment, psychotherapy, security enforcement, or law-enforcement functions.",
  "If a guest may be medically unsafe, event medical or emergency response should be contacted first."
];

---

<BaseLayout title="For Event Organizers" description="SJS services, staffing model, setup needs, coordination, and partnership inquiry information for event organizers.">
  <PageHero
    eyebrow="For event organizers"
    title="Add peer support and harm reduction to your safety plan."
    text="SJS helps organizers create calm sanctuary spaces, provide practical harm-reduction support, and coordinate clearly with medical, security, ranger, venue, and operations teams."
    art="organizers"
  />

  <section class="section">
    <div class="container organizer-intro">
      <div class="prose">
        <p class="eyebrow">Why organizers bring in SJS</p>
        <h2>One team, clear roles.</h2>
        <p>
          SJS works best when it is part of the event care system before doors open. A simple integration plan helps avoid delayed escalation, duplicated response, unclear communication, and confusion about what peer support or harm-reduction services can and cannot do.
        </p>
      </div>
      <a class="button button-primary" href={site.forms.partnership}>Partnership Inquiry</a>
    </div>
  </section>

  <section class="section-tight organizer-band">
    <div class="container two-grid">
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="home" /></span>
        <h2>What SJS can provide</h2>
        <ul>
          {eventServices.map((service) => <li>{service}</li>)}
        </ul>
      </div>
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="shield" /></span>
        <h2>Scope boundaries</h2>
        <ul>
          {boundaries.map((boundary) => <li>{boundary}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-grid">
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="clipboard" /></span>
        <h2>Setup needs</h2>
        <ul>
          {setupNeeds.map((need) => <li>{need}</li>)}
        </ul>
      </div>
      <div class="surface service-card">
        <span class="card-icon" aria-hidden="true"><Icon name="map" /></span>
        <h2>Planning inputs</h2>
        <ul>
          {planningInputs.map((input) => <li>{input}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight battle-card">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Why SJS</p>
        <h2>Compare the integrated model.</h2>
      </div>
      <div class="prose">
        <p>
          The comparison shows how SJS combines sanctuary peer support, harm-reduction education, practical supplies, reagent testing when approved, and event coordination in one comprehensive model.
        </p>
        <a class="button button-primary" href="/why-sjs/">Compare SJS</a>
      </div>
    </div>
  </section>

  <section class="section-tight band">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">Integration model</p>
        <h2>SJS fits into the care system.</h2>
      </div>
      <div class="prose">
        <p>
          SJS scopes each deployment around event size, hours, risk profile, available space, and existing medical/security staffing. Volunteers complement professional responders; they do not replace them. When there is injury, abnormal breathing, overdose concern, heat illness, severe agitation, violence, suicidality, or uncertainty about medical risk, SJS escalates rather than trying to hold the situation internally.
        </p>
        <a class="button button-primary" href={site.forms.partnership}>Partnership Inquiry</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-card h2 {
    font-size: 1.22rem;
    margin: 0 0 12px;
  }

  .organizer-intro {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .organizer-intro .button {
    justify-self: end;
  }

  .organizer-band {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .battle-card {
    background: var(--linen);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  .service-card li + li {
    margin-top: 8px;
  }

  @media (max-width: 760px) {
    .organizer-intro {
      grid-template-columns: 1fr;
    }

    .organizer-intro .button {
      justify-self: start;
    }
  }
</style>
