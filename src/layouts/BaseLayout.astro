---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import "../styles/global.css";
import { site } from "../data/site";
import { absoluteUrl, assetPath } from "../utils/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = "/assets/sjs_home_background.png" } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const siteRoot = Astro.site ?? new URL(site.url);
const canonical = absoluteUrl(Astro.url.pathname, siteRoot);
const previewVars = `--sjs-logo-url: url("${assetPath("/assets/sjslogo.png")}"); --sjs-home-bg-url: url("${assetPath("/assets/sjs_home_background.png")}");`;
---

<!doctype html>
<html lang="en" style={previewVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={assetPath("/assets/sjslogo.png")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image, siteRoot)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("sjs-theme");

          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..800&family=Source+Sans+3:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const selectors = [
          "main > section",
          ".page-hero-grid > *",
          ".card-grid > *",
          ".split-grid > *",
          ".principle-stack > *",
          ".post-card",
          ".surface"
        ];

        const prepare = () => {
          if (reduceMotion.matches) return;
          document.querySelectorAll(selectors.join(",")).forEach((el) => {
            if (!el.hasAttribute("data-reveal")) {
              el.setAttribute("data-reveal", "");
            }
          });
        };

        const reveal = () => {
          prepare();
          const targets = document.querySelectorAll("[data-reveal]");
          if (!("IntersectionObserver" in window)) {
            targets.forEach((target) => target.removeAttribute("data-reveal"));
            return;
          }
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute("data-revealed", "");
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
          );
          targets.forEach((target, index) => {
            target.style.setProperty("--reveal-delay", `${Math.min(index % 4, 3) * 70}ms`);
            observer.observe(target);
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", reveal, { once: true });
        } else {
          reveal();
        }
      })();
    </script>
  </body>
</html>
