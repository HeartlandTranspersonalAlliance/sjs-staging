---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { site } from "../data/site";
import { absoluteUrl, assetPath } from "../utils/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = "/assets/events/ck2026/outside-sanctuary-welcome-night.jpeg" } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const siteRoot = Astro.site ?? new URL(site.url);
const canonical = absoluteUrl(Astro.url.pathname, siteRoot);
const previewVars = `--sjs-logo-url: url("${assetPath("/assets/sjslogo.png")}");`;
const pageTransition = {
  forwards: {
    old: {
      name: "sjs-page-exit",
      duration: "180ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "sjs-page-enter",
      duration: "210ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "sjs-page-exit",
      duration: "180ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "sjs-page-enter",
      duration: "210ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
};
---

<!doctype html>
<html lang="en" data-theme="dark" style={previewVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={assetPath("/assets/sjslogo.png")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image, siteRoot)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..800&family=Source+Sans+3:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter fallback="animate" />
  </head>
  <body transition:animate={pageTransition} transition:name="page">
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
