---
interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<nav class="site-container page-contents" aria-label="On this page">
  <p class="eyebrow">On this page</p>
  <ul role="list">
    {items.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .page-contents {
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin: 0 auto 36px;
    box-sizing: border-box;
    padding: 16px 18px;
  }

  .page-contents .eyebrow {
    margin-bottom: 10px;
  }

  .page-contents ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .page-contents a {
    align-items: center;
    display: inline-flex;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--button-ghost-bg);
    color: var(--link-strong);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  .page-contents a:hover {
    background: var(--button-ghost-bg-hover);
    border-color: var(--control-border-hover);
    text-decoration: underline;
  }
</style>
