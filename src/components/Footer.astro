---
import { site } from "../data/site";
import { assetPath, withBase } from "../utils/paths";

const footerGroups = [
  {
    title: "Explore",
    links: [
      { label: "About SJS", href: "/about/" },
      { label: "Model of Care", href: "/model/" },
      { label: "Resources", href: "/resources/" },
      { label: "News", href: "/news/" },
      { label: "FAQ", href: "/faq/" }
    ]
  },
  {
    title: "Get Involved",
    links: [
      { label: "Volunteer", href: "/volunteer/" },
      { label: "Training", href: "/training/" },
      { label: "Events", href: "/events/" },
      { label: "Donate", href: "/donate/" }
    ]
  },
  {
    title: "Partner",
    links: [
      { label: "For Event Organizers", href: "/organizers/" },
      { label: "Impact", href: "/impact/" },
      { label: "Contact", href: "/contact/" },
      { label: "Heartland Transpersonal Alliance", href: site.parentOrg.url, external: true }
    ]
  }
];

const quickLinks = [
  { label: "Volunteer Form", href: site.forms.volunteer },
  { label: "Partnership Inquiry", href: site.forms.partnership },
  { label: "Email SJS", href: `mailto:${site.email}` }
];
---

<footer class="site-footer">
  <div class="wide-container">
    <div class="footer-shell">
      <div class="footer-top">
        <div class="footer-brand">
          <a class="footer-logo-link" href={withBase("/")} aria-label={`${site.name} home`}>
            <img src={assetPath("/assets/sjslogo.png")} alt="" width="64" height="64" />
          </a>
          <div>
            <h2>{site.name}</h2>
            <p>{site.description}</p>
          </div>
        </div>

        <div class="footer-quick" aria-label="Quick actions">
          {quickLinks.map((link) => (
            <a href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="footer-main">
        <nav class="footer-link-grid" aria-label="Footer navigation">
          {
            footerGroups.map((group) => (
              <section class="footer-link-group" aria-labelledby={`footer-${group.title.toLowerCase().replaceAll(" ", "-")}`}>
                <h3 id={`footer-${group.title.toLowerCase().replaceAll(" ", "-")}`}>{group.title}</h3>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.external ? link.href : withBase(link.href)} rel={link.external ? "noreferrer" : undefined}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </nav>

        <aside class="footer-contact" aria-label="Contact and social links">
          <p class="eyebrow">Connect</p>
          <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
          <div class="footer-social">
            {site.social.map((link) => (
              <a href={link.url} rel="noreferrer" aria-label={link.label}>{link.label}</a>
            ))}
          </div>
        </aside>
      </div>

      <div class="footer-bottom">
        <p>
          &copy; {new Date().getFullYear()} {site.name}. {site.nonprofit}
        </p>
        <p>
          SJS provides education and peer support, not medical treatment, psychotherapy, legal advice, or endorsement of substance use. In an emergency, call 911 or contact on-site medical/security personnel.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background:
      radial-gradient(circle at 12% 0%, var(--body-halo-violet), transparent 24rem),
      var(--band-bg);
    color: var(--band-text);
    border-top: 1px solid var(--line);
    padding: 56px 0 34px;
  }

  .footer-shell {
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 22px 52px var(--shadow);
    overflow: hidden;
    padding: 28px;
  }

  .footer-top {
    align-items: flex-start;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .footer-brand {
    align-items: flex-start;
    display: flex;
    gap: 16px;
    max-width: 42rem;
  }

  .footer-logo-link {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: inline-flex;
    flex: 0 0 auto;
    justify-content: center;
    padding: 7px;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .footer-logo-link:hover {
    background: var(--button-ghost-bg-hover);
    border-color: var(--sjs-border-strong);
    transform: translateY(-1px);
  }

  .footer-brand img {
    height: 50px;
    width: 50px;
  }

  .footer-brand h2 {
    color: var(--band-text);
    font-size: 1.35rem;
    margin: 0 0 8px;
    max-width: none;
  }

  .footer-brand p,
  .footer-bottom p {
    color: var(--muted);
  }

  .footer-quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
    max-width: 27rem;
  }

  .footer-quick a {
    align-items: center;
    background: var(--button-ghost-bg);
    border: 1px solid var(--button-ghost-border);
    border-radius: 999px;
    display: inline-flex;
    font-size: 0.86rem;
    font-weight: 850;
    min-height: 38px;
    padding: 0.48rem 0.9rem;
    text-decoration: none;
  }

  .footer-main {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.28fr);
    margin-top: 28px;
    padding-top: 28px;
  }

  .footer-link-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .footer-link-group h3 {
    color: var(--band-text);
    font-family: "Source Sans 3", Aptos, "Segoe UI", sans-serif;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    margin: 0 0 13px;
    text-transform: uppercase;
  }

  .footer-link-group ul {
    display: grid;
    gap: 9px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link-group a {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  .footer-contact {
    border-left: 1px solid var(--line);
    padding-left: 28px;
  }

  .footer-contact .eyebrow {
    color: var(--amber);
    margin-bottom: 12px;
  }

  .footer-email {
    display: inline-flex;
    font-size: 0.95rem;
    font-weight: 850;
    line-height: 1.4;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .footer-social a {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: inline-flex;
    font-size: 0.85rem;
    font-weight: 850;
    min-height: 40px;
    padding: 0 12px;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .site-footer a {
    color: inherit;
  }

  .footer-quick a,
  .footer-email,
  .footer-social a {
    color: var(--link-strong);
  }

  .footer-link-group a {
    color: var(--muted);
  }

  .footer-link-group a:hover,
  .footer-quick a:hover,
  .footer-social a:hover,
  .site-footer a:hover {
    color: var(--link-strong);
    text-decoration: underline;
  }

  .footer-social a:hover {
    background: var(--icon-bg);
    border-color: var(--icon-border);
  }

  .site-footer a:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 5px var(--focus-ring);
  }

  .footer-bottom {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 12px;
    margin-top: 28px;
    padding-top: 24px;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  @media (max-width: 980px) {
    .footer-top,
    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-quick {
      justify-content: flex-start;
      max-width: none;
    }

    .footer-contact {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 24px;
    }
  }

  @media (max-width: 700px) {
    .site-footer {
      padding-top: 34px;
    }

    .footer-shell {
      padding: 20px;
    }

    .footer-brand {
      display: grid;
    }

    .footer-link-grid {
      grid-template-columns: 1fr;
    }

    .footer-quick a,
    .footer-social a {
      width: 100%;
    }
  }
</style>
