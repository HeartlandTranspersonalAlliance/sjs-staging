---
import { navItems, primaryCtas, site } from "../data/site";
import Icon from "./Icon.astro";
import { assetPath, withBase, withoutBase } from "../utils/paths";

const currentPath = withoutBase(Astro.url.pathname);

function isCurrentPage(href: string): boolean {
  const normalizedHref = href.endsWith("/") ? href : `${href}/`;
  const normalizedPath = currentPath.endsWith("/") ? currentPath : `${currentPath}/`;

  return normalizedPath === normalizedHref || normalizedPath.startsWith(normalizedHref);
}
---

<header class="site-header">
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="wide-container nav-shell" aria-label="Primary navigation">
    <a class="brand" href={withBase("/")} aria-label={`${site.name} home`}>
      <img src={assetPath("/assets/sjslogo.png")} alt="" width="42" height="42" />
      <span>{site.name}</span>
    </a>

    <div class="desktop-links" aria-label="Main pages">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrentPage(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <a class="nav-donate" href={withBase("/donate/")}>Donate</a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <Icon name="menu" />
          <span class="sr-only">Menu</span>
        </summary>
        <div class="mobile-panel">
          {
            navItems.map((item) => (
              <a href={withBase(item.href)} aria-current={isCurrentPage(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <div class="mobile-ctas">
            {primaryCtas.map((cta) => <a href={withBase(cta.href)}>{cta.label}</a>)}
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector(".site-header");
  const syncScrolledState = () => {
    header?.toggleAttribute("data-scrolled", window.scrollY > 12);
  };

  syncScrolledState();
  window.addEventListener("scroll", syncScrolledState, { passive: true });
</script>

<style>
  .site-header {
    backdrop-filter: blur(16px);
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    position: sticky;
    top: 0;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
    z-index: 45;
  }

  .site-header[data-scrolled] {
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.18);
  }

  .sr-only {
    clip: rect(0, 0, 0, 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .skip-link {
    background: var(--amber);
    color: #160f17;
    left: 16px;
    padding: 8px 12px;
    position: absolute;
    top: -48px;
    z-index: 50;
  }

  .skip-link:focus {
    top: 12px;
  }

  .nav-shell {
    align-items: center;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    min-height: 64px;
    transition: min-height 180ms ease;
  }

  .site-header[data-scrolled] .nav-shell {
    min-height: 56px;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    gap: 10px;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.04rem;
    font-weight: 760;
    line-height: 1;
    min-width: 0;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--violet);
  }

  .brand img {
    height: 42px;
    transition:
      height 180ms ease,
      width 180ms ease;
    width: 42px;
  }

  .site-header[data-scrolled] .brand img {
    height: 36px;
    width: 36px;
  }

  .desktop-links {
    align-items: center;
    display: flex;
    gap: 6px;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }

  .desktop-links a {
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 750;
    padding: 8px 13px;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .desktop-links a:hover {
    background: var(--nav-hover-bg);
    border-color: var(--nav-hover-border);
    color: var(--nav-hover-text);
  }

  .desktop-links a:focus-visible,
  .nav-donate:focus-visible,
  .mobile-menu summary:focus-visible,
  .mobile-panel a:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--paper),
      0 0 0 5px var(--focus-ring);
  }

  .desktop-links a[aria-current="page"] {
    background: var(--nav-active-bg);
    border-color: var(--nav-active-border);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
    color: var(--nav-active-text);
  }

  .nav-actions {
    align-items: center;
    display: flex;
    gap: 10px;
  }

  .nav-donate {
    background: var(--amber);
    border: 1px solid var(--button-border);
    border-radius: 999px;
    color: #170f08;
    font-weight: 850;
    min-height: 44px;
    padding: 9px 1.5rem;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .site-header[data-scrolled] .nav-donate {
    min-height: 40px;
    padding: 7px 1.35rem;
  }

  .nav-donate:hover {
    background: var(--amber-strong);
    transform: translateY(-1px);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    background: var(--control-bg);
    border: 1px solid var(--control-border);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    list-style: none;
    min-height: 44px;
    padding: 0;
    width: 44px;
  }

  .mobile-menu summary :global(svg) {
    height: 20px;
    width: 20px;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 24px 80px var(--shadow);
    display: grid;
    gap: 4px;
    min-width: min(20rem, calc(100vw - 2rem));
    padding: 12px;
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
  }

  .mobile-panel a {
    border-radius: 6px;
    color: var(--ink);
    font-weight: 800;
    padding: 10px 12px;
    text-decoration: none;
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current="page"] {
    background: var(--nav-active-bg);
    color: var(--nav-active-text);
  }

  .mobile-ctas {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 4px;
    margin-top: 8px;
    padding-top: 8px;
  }

  @media (max-width: 980px) {
    .desktop-links {
      display: none;
    }

    .mobile-menu {
      display: block;
      justify-self: end;
    }
  }

  @media (max-width: 480px) {
    .nav-shell {
      gap: 12px;
    }

    .brand span {
      max-width: 160px;
      overflow-wrap: anywhere;
    }

    .nav-donate {
      display: none;
    }
  }
</style>
