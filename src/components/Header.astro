---
import { navItems, primaryCtas, site } from "../data/site";
import { assetPath, withBase, withoutBase } from "../utils/paths";

const currentPath = withoutBase(Astro.url.pathname);
---

<header class="site-header">
  <a class="skip-link" href="#main">Skip to content</a>
  <nav class="wide-container nav-shell" aria-label="Primary navigation">
    <a class="brand" href={withBase("/")} aria-label={`${site.name} home`}>
      <img src={assetPath("/assets/sjslogo.png")} alt="" width="42" height="42" />
      <span>{site.name}</span>
    </a>

    <div class="desktop-links" aria-label="Main pages">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={currentPath === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light mode" aria-pressed="false">
        <svg class="theme-toggle-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M20.1 14.3A7.6 7.6 0 0 1 9.7 3.9 8.2 8.2 0 1 0 20.1 14.3Z" />
        </svg>
        <svg class="theme-toggle-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.8v2.1M12 19.1v2.1M4.5 4.5 6 6M18 18l1.5 1.5M2.8 12h2.1M19.1 12h2.1M4.5 19.5 6 18M18 6l1.5-1.5" />
        </svg>
      </button>

      <a class="nav-donate" href={withBase("/donate/")}>Donate</a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">Menu</summary>
        <div class="mobile-panel">
          {
            navItems.map((item) => (
              <a href={withBase(item.href)} aria-current={currentPath === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <div class="mobile-ctas">
            {primaryCtas.map((cta) => <a href={withBase(cta.href)}>{cta.label}</a>)}
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const root = document.documentElement;

  function currentTheme(): "light" | "dark" {
    return root.dataset.theme === "light" ? "light" : "dark";
  }

  function setTheme(theme: "light" | "dark") {
    root.dataset.theme = theme;
    themeToggle?.setAttribute("aria-pressed", String(theme === "light"));
    themeToggle?.setAttribute("aria-label", theme === "light" ? "Switch to dark mode" : "Switch to light mode");
  }

  setTheme(currentTheme());

  themeToggle?.addEventListener("click", () => {
    const nextTheme = currentTheme() === "light" ? "dark" : "light";
    setTheme(nextTheme);

    try {
      localStorage.setItem("sjs-theme", nextTheme);
    } catch {
      // Preference persistence is non-critical.
    }
  });
</script>

<style>
  .site-header {
    backdrop-filter: blur(16px);
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    position: sticky;
    top: 0;
    z-index: 45;
  }

  .skip-link {
    background: var(--amber);
    color: #160f17;
    left: 16px;
    padding: 8px 12px;
    position: absolute;
    top: -48px;
    z-index: 50;
  }

  .skip-link:focus {
    top: 12px;
  }

  .nav-shell {
    align-items: center;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    min-height: 64px;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    gap: 10px;
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.04rem;
    font-weight: 760;
    line-height: 1;
    min-width: 0;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--violet);
  }

  .brand img {
    height: 42px;
    width: 42px;
  }

  .desktop-links {
    align-items: center;
    display: flex;
    gap: 6px;
    flex: 1;
    justify-content: center;
    min-width: 0;
  }

  .desktop-links a {
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 750;
    padding: 8px 13px;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .desktop-links a:hover {
    background: var(--nav-hover-bg);
    border-color: var(--nav-hover-border);
    color: var(--nav-hover-text);
  }

  .desktop-links a[aria-current="page"] {
    background: var(--nav-active-bg);
    border-color: var(--nav-active-border);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
    color: var(--nav-active-text);
  }

  .nav-actions {
    align-items: center;
    display: flex;
    gap: 10px;
  }

  .theme-toggle {
    align-items: center;
    background: var(--control-bg);
    border: 1px solid var(--control-border);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    height: 44px;
    justify-content: center;
    padding: 0;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
    width: 44px;
  }

  .theme-toggle:hover {
    background: var(--control-bg-hover);
    border-color: var(--control-border-hover);
    transform: translateY(-1px);
  }

  .theme-toggle svg {
    height: 20px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    width: 20px;
  }

  .theme-toggle-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .theme-toggle-moon {
    display: none;
  }

  :global(html[data-theme="light"]) .theme-toggle-sun {
    display: block;
  }

  .nav-donate {
    background: var(--amber);
    border: 1px solid var(--button-border);
    border-radius: 999px;
    color: #170f08;
    font-weight: 850;
    min-height: 44px;
    padding: 9px 17px;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .nav-donate:hover {
    background: var(--amber-strong);
    transform: translateY(-1px);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    background: var(--control-bg);
    border: 1px solid var(--control-border);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 800;
    list-style: none;
    min-height: 44px;
    padding: 8px 14px;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 24px 80px var(--shadow);
    display: grid;
    gap: 4px;
    min-width: 240px;
    padding: 12px;
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
  }

  .mobile-panel a {
    border-radius: 6px;
    color: var(--ink);
    font-weight: 800;
    padding: 10px 12px;
    text-decoration: none;
  }

  .mobile-panel a:hover,
  .mobile-panel a[aria-current="page"] {
    background: var(--nav-active-bg);
    color: var(--nav-active-text);
  }

  .mobile-ctas {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 4px;
    margin-top: 8px;
    padding-top: 8px;
  }

  @media (max-width: 980px) {
    .desktop-links {
      display: none;
    }

    .mobile-menu {
      display: block;
      justify-self: end;
    }
  }

  @media (max-width: 480px) {
    .nav-shell {
      gap: 12px;
    }

    .brand span {
      max-width: 160px;
      overflow-wrap: anywhere;
    }

    .nav-donate {
      display: none;
    }
  }
</style>
