---
import { Icon as AstroIcon } from "astro-icon/components";

interface Props {
  name?: string;
  title?: string;
}

const { name = "sparkles", title } = Astro.props;

const icons: Record<string, string> = {
  "arrow-up": "tabler:arrow-up",
  book: "tabler:book-2",
  calendar: "tabler:calendar",
  clipboard: "tabler:clipboard-list",
  compass: "tabler:compass",
  cross: "tabler:first-aid-kit",
  ear: "tabler:ear",
  gift: "tabler:gift",
  handshake: "tabler:heart-handshake",
  heart: "tabler:heart",
  home: "tabler:home",
  mail: "tabler:mail",
  map: "tabler:map",
  menu: "tabler:menu-2",
  message: "tabler:message",
  package: "tabler:package",
  shield: "tabler:shield-check",
  sparkles: "tabler:sparkles",
  users: "tabler:users-group",
};

const iconName = icons[name] ?? icons.sparkles;
const labelled = Boolean(title);
---

<AstroIcon
  name={iconName}
  class="icon"
  aria-hidden={labelled ? undefined : "true"}
  role={labelled ? "img" : undefined}
>
  {title && <title>{title}</title>}
</AstroIcon>

<style>
  .icon {
    display: block;
    height: 1em;
    width: 1em;
  }
</style>
