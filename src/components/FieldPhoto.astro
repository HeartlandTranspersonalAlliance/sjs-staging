---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: string; alt: string; eager?: boolean; class?: string; style?: string; sizes?: string; }
const {
  src, alt, eager = false, class: className, style,
  sizes = "(max-width: 767px) calc(100vw - 3rem), (max-width: 900px) calc(100vw - 4rem), (max-width: 1023px) calc((100vw - 4rem - 56px) / 2), (max-width: 1360px) calc((100vw - 5rem - 56px) / 2), 612px"
} = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../../public/assets/**/*.{jpeg,jpg,png}", { eager: true });
const photo = photos[`../../public${src}`]?.default;
if (!photo) throw new Error(`Unknown field photo: ${src}`);
---
<Image src={photo} alt={alt} widths={[320, 480, 640, 800, 1200].filter(width => width <= photo.width)} sizes={sizes} format="webp" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} class={className} style={style} />
