---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: string; alt: string; eager?: boolean; class?: string; style?: string; }
const { src, alt, eager = false, class: className, style } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../../public/assets/**/*.{jpeg,jpg,png}", { eager: true });
const photo = photos[`../../public${src}`]?.default;
if (!photo) throw new Error(`Unknown field photo: ${src}`);
---
<Image src={photo} alt={alt} widths={[480, 800, 1200].filter(width => width <= photo.width)} sizes="(max-width: 900px) calc(100vw - 3rem), 50vw" format="webp" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} class={className} style={style} />
