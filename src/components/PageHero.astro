---
import { assetPath } from "../utils/paths";
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  art?: "sanctuary" | "training" | "resources" | "support" | "contact" | "events" | "organizers" | "impact" | "news";
}

const { eyebrow, title, text, image, imageAlt = "", imagePosition = "center", art } = Astro.props;
const placeholderByArt = {
  sanctuary: "/assets/placeholders/sanctuary-support.png",
  training: "/assets/placeholders/sanctuary-support.png",
  resources: "/assets/placeholders/sanctuary-resources.png",
  support: "/assets/placeholders/sanctuary-support.png",
  contact: "/assets/placeholders/sanctuary-contact.png",
  events: "/assets/placeholders/sanctuary-events.png",
  organizers: "/assets/placeholders/sanctuary-organizers.png",
  impact: "/assets/placeholders/sanctuary-impact.png",
  news: "/assets/placeholders/sanctuary-contact.png"
};
const placeholderImage = art ? placeholderByArt[art] : undefined;
const heroImage = image ? assetPath(image) : placeholderImage ? assetPath(placeholderImage) : undefined;
const resolvedImageAlt = image ? imageAlt : "";
const hasVisual = Boolean(heroImage || art);
const artIcon = {
  sanctuary: "home",
  training: "clipboard",
  resources: "book",
  support: "gift",
  contact: "message",
  events: "calendar",
  organizers: "map",
  impact: "sparkles",
  news: "message"
}[art ?? "resources"];
---

<section class="page-hero">
  <div class="container page-hero-grid">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lede">{text}</p>
    </div>
    {
      hasVisual && (
        <div class="page-hero-visual">
          {
            heroImage ? (
              <img
                class="page-hero-image"
                src={heroImage}
                alt={resolvedImageAlt}
                loading="eager"
                decoding="async"
                style={`object-position: ${imagePosition};`}
              />
            ) : (
              <div class="page-hero-art" data-art={art} aria-hidden="true">
                <div class="art-mark">
                  <Icon name={artIcon} />
                </div>
                <div class="art-lines">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="art-steps">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            )
          }
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(circle at 12% 12%, var(--body-halo-violet), transparent 30rem),
      linear-gradient(135deg, var(--body-halo-amber), transparent 54%),
      var(--linen);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding: 80px 0;
    position: relative;
  }

  .page-hero::before {
    background: var(--sjs-logo-url) center / contain no-repeat;
    content: "";
    height: 30rem;
    opacity: 0.025;
    pointer-events: none;
    position: absolute;
    right: -10rem;
    top: -12rem;
    width: 30rem;
  }

  .page-hero > .container {
    position: relative;
  }

  .page-hero-grid {
    align-items: center;
    display: grid;
    gap: 44px;
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.72fr);
  }

  .page-hero h1 {
    font-size: clamp(2.45rem, 7vw, 4.4rem);
    line-height: 1.04;
    margin: 12px 0 18px;
    max-width: min(100%, 14em);
    text-wrap: balance;
  }

  .page-hero .lede {
    max-width: 39rem;
  }

  .page-hero-visual {
    position: relative;
  }

  .page-hero-image,
  .page-hero-art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow:
      0 20px 58px var(--shadow),
      0 0 0 8px rgb(169 112 221 / 0.06);
    width: 100%;
  }

  .page-hero-image {
    display: block;
    object-fit: cover;
  }

  .page-hero-art {
    --art-accent: var(--violet);
    --art-line: rgb(255 255 255 / 0.15);
    align-items: center;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.018) 1px, transparent 1px),
      linear-gradient(180deg, rgb(255 255 255 / 0.014) 1px, transparent 1px),
      linear-gradient(135deg, color-mix(in srgb, var(--art-accent) 24%, transparent), transparent 54%),
      var(--surface-strong);
    background-size: 52px 52px, 52px 52px, auto, auto;
    display: grid;
    justify-items: center;
    overflow: hidden;
    padding: 28px;
    position: relative;
  }

  .page-hero-art::before {
    background: var(--sjs-logo-url) center / contain no-repeat;
    content: "";
    height: 20rem;
    opacity: 0.05;
    position: absolute;
    right: -6rem;
    top: -6rem;
    width: 100%;
  }

  .page-hero-art[data-art="training"] {
    --art-accent: var(--amber);
  }

  .page-hero-art[data-art="resources"] {
    --art-accent: var(--sage);
  }

  .page-hero-art[data-art="support"] {
    --art-accent: var(--rose);
  }

  .page-hero-art[data-art="contact"] {
    --art-accent: var(--violet);
  }

  .page-hero-art[data-art="events"] {
    --art-accent: var(--amber);
  }

  .page-hero-art[data-art="organizers"] {
    --art-accent: var(--sage);
  }

  .page-hero-art[data-art="impact"] {
    --art-accent: var(--rose);
  }

  .page-hero-art[data-art="news"] {
    --art-accent: var(--violet);
  }

  .art-mark {
    align-items: center;
    background: var(--icon-bg);
    border: 1px solid var(--icon-border);
    border-radius: 8px;
    color: var(--art-accent);
    display: inline-flex;
    height: 84px;
    justify-content: center;
    position: relative;
    width: 84px;
    z-index: 1;
  }

  .art-mark :global(svg) {
    height: 42px;
    width: 42px;
  }

  .art-lines {
    display: grid;
    gap: 12px;
    margin-top: 28px;
    position: relative;
    width: min(78%, 18rem);
    z-index: 1;
  }

  .art-lines span {
    background: var(--art-line);
    border-radius: 999px;
    height: 8px;
  }

  .art-lines span:nth-child(2) {
    width: 72%;
  }

  .art-lines span:nth-child(3) {
    width: 54%;
  }

  .art-steps {
    bottom: 28px;
    display: flex;
    gap: 10px;
    position: absolute;
    right: 28px;
    z-index: 1;
  }

  .art-steps span {
    border: 1px solid var(--art-accent);
    border-radius: 2px;
    height: 8px;
    opacity: 0.75;
    width: 22px;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: 96px 0;
    }
  }

  @media (min-width: 1024px) {
    .page-hero {
      padding: 108px 0;
    }
  }

  @media (max-width: 860px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
    }

    .page-hero::before {
      display: none;
    }

    .page-hero {
      padding: 72px 0;
    }
  }
</style>
