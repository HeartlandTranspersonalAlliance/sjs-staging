---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, text, image, imageAlt = "" } = Astro.props;
---

<section class="page-hero">
  <div class="container page-hero-grid">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lede">{text}</p>
    </div>
    {
      image && (
        <img class="page-hero-image" src={image} alt={imageAlt} loading="eager" decoding="async" />
      )
    }
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(circle at 12% 12%, rgb(169 112 221 / 0.18), transparent 30rem),
      linear-gradient(135deg, rgb(242 160 68 / 0.06), transparent 54%),
      var(--linen);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding: 80px 0;
    position: relative;
  }

  .page-hero::before {
    background: url("/assets/sjslogo.png") center / contain no-repeat;
    content: "";
    height: 30rem;
    opacity: 0.03;
    pointer-events: none;
    position: absolute;
    right: -10rem;
    top: -12rem;
    width: 30rem;
  }

  .page-hero > .container {
    position: relative;
  }

  .page-hero-grid {
    align-items: center;
    display: grid;
    gap: 44px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
  }

  .page-hero h1 {
    margin: 12px 0 18px;
    max-width: 52rem;
  }

  .page-hero .lede {
    max-width: 42rem;
  }

  .page-hero-image {
    aspect-ratio: 4 / 3;
    border: 1px solid rgb(255 242 220 / 0.16);
    border-radius: 16px;
    box-shadow:
      0 20px 60px rgb(0 0 0 / 0.32),
      0 0 0 8px rgb(169 112 221 / 0.08);
    object-fit: cover;
    width: 100%;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: 96px 0;
    }
  }

  @media (min-width: 1024px) {
    .page-hero {
      padding: 108px 0;
    }
  }

  @media (max-width: 860px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
    }

    .page-hero::before {
      display: none;
    }
  }
</style>
