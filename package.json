{
  "name": "safe-journey-sanctum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "check": "astro check",
    "validate": "node scripts/validate-site.mjs",
    "build:staging": "node scripts/build-staging.mjs",
    "preview": "astro preview",
    "test:browser": "playwright test --workers=1",
    "test:ci": "npm run build && npm run validate && npm run test:browser && npm run build:staging && SITE_BASE=/sjs-staging/ npm run test:browser"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "@iconify-json/tabler": "^1.2.35",
    "astro": "^5.13.8",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "typescript": "^5.9.2"
  }
}
